<%- include('partials/header') %>
    <%- include('partials/toast') %>
        <%- include('partials/nav') %>

            <main class="flex-grow flex flex-col items-center px-4 pt-48 pb-10 relative z-10 w-full">
                <!-- Global Files Section -->
                <div class="w-full max-w-4xl space-y-8">
                                    <div class="text-center mb-8">
                                        <h1
                                            class="text-4xl md:text-5xl font-bold tracking-tight flex items-center justify-center gap-3">
                                            <i class="ri-global-line text-cyan-300"></i>
                                            <span>Global Hub</span>
                                        </h1>
                                        <p class="text-blue-100 mt-2 text-lg font-light">Discover public files shared by
                                            the
                                            community</p>
                                    </div>

                                    <div class="glass-panel rounded-2xl shadow-2xl overflow-hidden p-1">
                                        <div class="h-[300px] overflow-y-auto custom-scrollbar p-4 space-y-3">
                                            <% if (files.length===0) { %>
                                                <div
                                                    class="flex flex-col items-center justify-center h-full text-white/40">
                                                    <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                                                    <p class="text-xl">No public files available yet.</p>
                                                </div>
                                                <% } %>

                                                    <% files.forEach(file=> { %>
                                                        <div
                                                            class="glass-card flex items-center justify-between p-4 rounded-xl group">
                                                            <div class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                                                                <div
                                                                    class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-white/10 flex items-center justify-center text-cyan-300">
                                                                    <i class="ri-file-line text-xl"></i>
                                                                </div>
                                                                <div class="truncate">
                                                                    <a href="/view-public/<%= encodeURIComponent(file.s3Key) %>"
                                                                        class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                                                        <%= file.originalName %>
                                                                    </a>

                                                                    <div class="flex items-center gap-2 mt-0.5">
                                                                        <span
                                                                            class="text-sm font-medium text-blue-200/70">
                                                                            @<%= file.owner ? file.owner.username
                                                                                : 'Unknown' %>
                                                                        </span>
                                                                        <% if (file.size) { %>
                                                                            <span class="text-xs text-blue-200/70">
                                                                                • <%= (file.size / 1024 /
                                                                                    1024).toFixed(2) %> MB
                                                                            </span>
                                                                            <% } %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <!-- Action Buttons Container -->
                                                            <div class="flex items-center gap-3">
                                                                <% const isFileOwner=user && file.owner &&
                                                                    (file.owner._id ? file.owner._id.toString() :
                                                                    file.owner.toString())===user._id.toString(); if
                                                                    (!isFileOwner) { %>
                                                                    <a href="/download-public/<%= encodeURIComponent(file.s3Key) %>"
                                                                        download="<%= file.originalName %>"
                                                                        title="Download"
                                                                        class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                                            class="ri-download-line text-xl"></i></a>
                                                                    <% } %>
                                                                        <% if (isFileOwner) { %>
                                                                            <button
                                                                                onclick="deleteFile('<%= file._id %>', this)"
                                                                                title="Delete"
                                                                                class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110 cursor-pointer"><i
                                                                                    class="ri-delete-bin-line text-xl"></i></button>
                                                                            <% } %>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                        </div>
                                    </div>

                                    <div class="flex flex-col sm:flex-row justify-center items-center gap-5 mt-8">
                                        <button id="open-upload-btn"
                                            class="btn-premium w-full sm:flex-1 rounded-full border-2 border-white/40 text-white px-8 py-3.5 font-bold hover:bg-white hover:text-blue-900 hover:border-white transition-all duration-400">
                                            <i class="ri-upload-cloud-2-line text-xl btn-icon-anim"></i>
                                            <span class="btn-text">Upload to Global Hub</span>
                                        </button>
                                    </div>
                </div>

                <!-- User Space Files Section -->

                <div class="w-full max-w-4xl space-y-8 mt-32">
                    <div class="text-center mb-8">
                        <h1
                            class="text-4xl md:text-5xl font-bold tracking-tight flex items-center justify-center gap-3">
                            <i class="ri-global-line text-cyan-300"></i>
                            <span>User Hub</span>
                        </h1>
                        <p class="text-blue-100 mt-2 text-lg font-light">Discover public files shared by the
                            community members</p>
                    </div>
                    <form id="space-search-form" class="flex flex-col sm:flex-row justify-center items-center gap-3">
                        <div class="relative w-full max-w-md">
                            <i
                                class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-white/50 text-xl pointer-events-none"></i>
                            <input id="space-search-input" name="space" type="search" placeholder="Search space by name"
                                class="w-full bg-white/5 border border-white/10 rounded-full pl-12 pr-4 py-3 text-white placeholder:text-white/40 focus:outline-none focus:border-white/40" />
                        </div>
                        <button type="submit" class="hidden"></button>
                        <button type="button" id="space-search-reset"
                            class="btn-premium w-full sm:flex-1 rounded-full bg-white text-blue-900 px-4 py-2 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none">
                            <i class="ri-loop-left-fill text-xl btn-icon-anim"></i>
                            <span class="btn-text">Reset</span>
                        </button>
                        <button type="button" id="create-space-btn"
                            class="btn-premium w-full sm:flex-1 rounded-full border-2 border-white/40 text-white px-4 py-2 font-bold hover:border-white/70 hover:text-blue-900 hover:bg-white hover:border-white transition-all duration-400">
                            <i class="ri-folder-add-line text-xl btn-icon-anim"></i>
                            <span class="btn-text">Create Space</span>
                        </button>
                    </form>
                    <div id="space-search-msg" class="text-center text-sm text-white/60 mt-3"></div>
                    <div id="spaces-container" class="space-y-8">
                                        <% if (typeof publicSpaces !=='undefined' && publicSpaces &&
                                            publicSpaces.length> 0) {
                                            %>
                                            <% publicSpaces.forEach(space=> { %>
                                                <% const ownerId=space.owner ? (space.owner._id ||
                                                    space.owner).toString() : null; const isOwner=user && ownerId &&
                                                    user._id.toString()===ownerId; const
                                                    downloadsAllowed=!!space.allowDownloads; const
                                                    uploadsAllowed=!!space.allowUploads; const canDownload=isOwner ||
                                                    downloadsAllowed; const canUpload=isOwner || uploadsAllowed; %>
                                                    <div class="glass-panel rounded-[2rem] p-8 relative overflow-hidden"
                                                        data-space-id="<%= space._id %>"
                                                        data-space-name="<%= space.name %>"
                                                        data-allow-downloads="<%= downloadsAllowed %>"
                                                        data-owner-id="<%= ownerId %>">
                                                        <div
                                                            class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center gap-4 mb-8">
                                                            <div class="flex items-center gap-4">
                                                                <div
                                                                    class="w-10 h-10 sm:w-12 sm:h-12 bg-white/10 rounded-2xl flex items-center justify-center border-white-500/30">
                                                                    <i
                                                                        class="ri-folder-3-line text-2xl text-white/60"></i>
                                                                </div>
                                                                <div>
                                                                    <h3
                                                                        class="text-2xl font-bold text-white flex items-center gap-2">
                                                                        <%= space.name %>
                                                                    </h3>
                                                                    <p class="text-sm text-white/60">Created by <span
                                                                            class="font-medium">@<%= (space.owner &&
                                                                                space.owner.username) ?
                                                                                space.owner.username : 'Unknown' %>
                                                                        </span></p>
                                                                </div>
                                                            </div>
                                                            <div class="flex items-center gap-3">
                                                                <% if (canDownload) { %>
                                                                    <a href="/download-public-space-all/<%= space._id %>"
                                                                        title="Download All"
                                                                        class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                                        <i class="ri-download-line text-xl"></i>
                                                                    </a>
                                                                    <% } %>

                                                                        <% if (canUpload) { %>
                                                                            <button data-space-id="<%= space._id %>"
                                                                                data-space-name="<%= space.name %>"
                                                                                onclick="openSpaceUpload(this.dataset.spaceId, this.dataset.spaceName)"
                                                                                title="Upload"
                                                                                class="flex-shrink-0 bg-white/10 hover:bg-blue-500 hover:text-white text-blue-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                                                <i class="ri-upload-cloud-2-line"></i>
                                                                            </button>
                                                                            <% } %>

                                                                                <% if(isOwner) { %>
                                                                                    <button
                                                                                        data-space-id="<%= space._id %>"
                                                                                        onclick="deleteSpace(this.dataset.spaceId)"
                                                                                        title="Delete"
                                                                                        class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                                                        <i
                                                                                            class="ri-delete-bin-line text-xl"></i>
                                                                                    </button>
                                                                                    <% } %>
                                                            </div>
                                                        </div>

                                                        <div
                                                            class="glass-panel-light rounded-2xl h-[250px] overflow-y-auto custom-scrollbar py-4 space-y-3">
                                                            <% if(!space.files || space.files.length===0) { %>
                                                                <div
                                                                    class="flex flex-col items-center justify-center h-full text-white/40">
                                                                    <i
                                                                        class="ri-folder-open-line text-6xl mb-4 block"></i>
                                                                    <p class="text-xl">No public files available yet.
                                                                    </p>
                                                                </div>
                                                                <% } else { %>
                                                                    <% space.files.forEach(file=> { %>
                                                                        <div
                                                                            class="glass-card flex items-center justify-between p-4 rounded-xl group">
                                                                            <div
                                                                                class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                                                                                <div
                                                                                    class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-white/10 flex items-center justify-center text-cyan-300">
                                                                                    <i class="ri-file-line text-xl"></i>
                                                                                </div>
                                                                                <div class="truncate">
                                                                                    <a href="/view-public/<%= encodeURIComponent(file.s3Key) %>"
                                                                                        class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                                                                        <%= file.originalName %>
                                                                                    </a>
                                                                                    <div
                                                                                        class="flex items-center gap-2 mt-0.5">
                                                                                        <span
                                                                                            class="text-sm font-medium text-blue-200/70">
                                                                                            @<%= file.owner &&
                                                                                                file.owner.username ?
                                                                                                file.owner.username
                                                                                                : 'Unknown' %>
                                                                                        </span>
                                                                                        <% if (file.size) { %>
                                                                                            <span
                                                                                                class="text-xs text-blue-200/70">
                                                                                                • <%= (file.size / 1024
                                                                                                    / 1024).toFixed(2)
                                                                                                    %> MB
                                                                                            </span>
                                                                                            <% } %>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="flex items-center gap-3">
                                                                                <% const isFileOwner=user && file.owner
                                                                                    && (file.owner._id ||
                                                                                    file.owner).toString()===user._id.toString();
                                                                                    if (canDownload && !isFileOwner) {
                                                                                    %>
                                                                                    <a href="/download-public/<%= encodeURIComponent(file.s3Key) %>"
                                                                                        download="<%= file.originalName %>"
                                                                                        class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                                                        <i
                                                                                            class="ri-download-line text-xl"></i>
                                                                                    </a>
                                                                                    <% } %>
                                                                                        <% if (user && (file.owner &&
                                                                                            (file.owner._id ||
                                                                                            file.owner).toString()===user._id.toString()
                                                                                            || isOwner)) { %>
                                                                                            <button
                                                                                                onclick="deletePublicFile('<%= space._id %>', '<%= file._id %>', this)"
                                                                                                title="Delete"
                                                                                                class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                                                                    class="ri-delete-bin-line text-xl"></i></button>
                                                                                            <% } %>
                                                                            </div>
                                                                        </div>
                                                                        <% }) %>
                                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <div class="text-center text-white/50 py-10">
                                                                <i
                                                                    class="ri-folder-add-line text-5xl mb-3 block opacity-50"></i>
                                                                <p>No user spaces created yet. Be the first!</p>
                                                            </div>
                                                            <% } %>
                    </div>
                </div>
            </main>
            <!-- Create Space Modal -->
            <div id="createSpaceModal"
                class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-md px-4 text-center">
                <div class="glass-panel w-full max-w-lg rounded-2xl p-8 shadow-2xl relative">
                    <button onclick="document.getElementById('createSpaceModal').classList.add('hidden')"
                        class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors">
                        <i class="ri-close-line text-3xl"></i>
                    </button>

                    <div
                        class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-white/20 shadow-inner">
                        <i class="ri-folder-add-fill text-3xl text-cyan-300"></i>
                    </div>

                    <h2 class="text-2xl font-bold mb-2 text-white">Create a New Space</h2>
                    <p class="text-blue-200 text-sm mb-8">Create a general space to share files securely.</p>

                    <form id="create-space-form" class="space-y-5">
                        <div class="relative">
                            <i
                                class="ri-folder-3-line absolute left-4 top-1/2 -translate-y-1/2 text-white/50 text-xl pointer-events-none"></i>
                            <input type="text" name="name" required placeholder="Space Name"
                                class="w-full bg-white/5 border border-white/10 rounded-xl pl-12 pr-4 py-3.5 text-white placeholder:text-white/40 focus:outline-none focus:border-cyan-400/50 focus:bg-white/10 transition-all" />
                        </div>

                        <div class="flex items-center justify-between bg-white/5 p-4 rounded-xl border border-white/10">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-white/10 rounded-lg text-cyan-300">
                                    <i class="ri-shield-user-line text-xl"></i>
                                </div>
                                <div class="text-left">
                                    <p class="text-sm font-medium text-white">Allow Uploads</p>
                                    <p class="text-xs text-white/50">Others can upload files</p>
                                </div>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="allowUploads" value="true" class="sr-only peer" checked>
                                <div
                                    class="w-11 h-6 bg-white/20 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-500">
                                </div>
                            </label>
                        </div>

                        <div class="flex items-center justify-between bg-white/5 p-4 rounded-xl border border-white/10">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-white/10 rounded-lg text-green-300">
                                    <i class="ri-download-cloud-2-line text-xl"></i>
                                </div>
                                <div class="text-left">
                                    <p class="text-sm font-medium text-white">Allow Downloads</p>
                                    <p class="text-xs text-white/50">Others can download files</p>
                                </div>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="allowDownloads" value="true" class="sr-only peer" checked>
                                <div
                                    class="w-11 h-6 bg-white/20 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500">
                                </div>
                            </label>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 pt-4">
                            <button type="button"
                                onclick="document.getElementById('createSpaceModal').classList.add('hidden')"
                                class="btn-premium w-full flex-1 rounded-full border-2 border-white/40 text-white px-4 py-3 font-bold hover:border-white/70 hover:text-blue-900 hover:bg-white hover:border-white transition-all duration-400">
                                <i class="ri-close-line text-xl btn-icon-anim"></i>
                                <span class="btn-text">Cancel</span>
                            </button>
                            <button type="submit"
                                class="btn-premium w-full flex-1 rounded-full bg-white text-blue-900 px-4 py-3 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none">
                                <i class="ri-add-line text-xl btn-icon-anim"></i>
                                <span class="btn-text">Create Space</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Upload to Space Modal -->
            <div id="spaceUploadModal"
                class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-md px-4 text-center">
                <div class="glass-panel w-full max-w-lg rounded-2xl p-8 shadow-2xl relative">
                    <button onclick="document.getElementById('spaceUploadModal').classList.add('hidden')"
                        class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors">
                        <i class="ri-close-line text-3xl"></i>
                    </button>
                    <div class="text-center mb-6">
                        <h2 id="spaceUploadTitle" class="text-2xl font-bold text-white">Upload to Space</h2>
                        <p id="spaceUploadDesc" class="text-blue-200 text-sm">Share files privately to this space.</p>
                    </div>
                    <form id="spaceUploadForm" method="POST" enctype="multipart/form-data">
                        <label
                            class="flex h-48 w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/30 bg-white/5 hover:bg-white/10 group">
                            <div id="space-dropzone-content"
                                class="flex flex-col items-center justify-center pt-5 pb-6 text-white/70 group-hover:text-white transition-colors">
                                <i
                                    class="ri-upload-cloud-line text-4xl text-cyan-300 mb-2 group-hover:scale-110 transition-transform"></i>
                                <p class="mb-2 text-sm"><span class="font-semibold text-cyan-200">Click to select
                                        files</span>
                                </p>
                                <p class="text-xs text-white/50">Multiple files allowed (MAX. 10MB each)</p>
                            </div>

                            <div id="space-filename-display" class="hidden text-center text-white font-medium p-4">
                                <i class="ri-file-check-line text-4xl text-green-400 mb-2 block"></i>
                                <span id="space-file-name-text"></span>
                            </div>

                            <input id="space-dropzone-file" type="file" name="file" class="hidden" required multiple />
                        </label>
                        <button type="submit"
                            class="btn-premium mt-6 w-full rounded-full bg-white text-blue-900 py-3.5 font-bold hover:bg-transparent hover:border-white hover:text-white border-2 border-transparent transition-all duration-400">
                            <i class="ri-upload-cloud-2-line text-xl btn-icon-anim"></i>
                            <span class="btn-text">Upload Now</span>
                        </button>
                    </form>
                </div>
            </div>

            <div id="popup"
                class="fixed inset-0 z-[100] flex hidden items-center justify-center bg-black/60 opacity-0 backdrop-blur-sm p-4 transition-opacity duration-300">
                <div class="glass-panel w-full max-w-lg scale-95 transform rounded-2xl p-8 shadow-2xl relative">
                    <button onclick="hidePopUp()" class="absolute top-4 right-4 text-white/70 hover:text-white">
                        <i class="ri-close-line text-3xl"></i>
                    </button>
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-white">Share Globally</h3>
                        <p class="text-blue-200 text-sm">This file will be visible to everyone</p>
                    </div>
                    <form id="globalUploadForm" action="/upload-global" method="post" enctype="multipart/form-data">
                        <label
                            class="flex h-48 w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/30 bg-white/5 hover:bg-white/10 group">
                            <div id="dropzone-content-global"
                                class="flex flex-col items-center justify-center pt-5 pb-6 text-white/70 group-hover:text-white transition-colors">
                                <i
                                    class="ri-upload-cloud-line text-4xl text-cyan-300 mb-2 group-hover:scale-110 transition-transform"></i>
                                <p class="mb-2 text-sm"><span class="font-semibold text-cyan-200">Click to select
                                        file</span>
                                </p>
                                <p class="text-xs text-white/50">Multiple files allowed (MAX. 10MB each)</p>
                            </div>

                            <div id="filename-display-global" class="hidden text-center text-white font-medium p-4">
                                <i class="ri-file-check-line text-4xl text-green-400 mb-2 block"></i>
                                <span id="file-name-text-global"></span>
                            </div>

                            <input id="dropzone-file-global" type="file" name="file" class="hidden" required multiple />
                        </label>
                        <button type="submit"
                            class="btn-premium mt-6 w-full rounded-full bg-white text-blue-900 py-3.5 font-bold hover:bg-transparent hover:border-white hover:text-white border-2 border-transparent transition-all duration-400">
                            <i class="ri-upload-cloud-2-line text-xl btn-icon-anim"></i>
                            <span class="btn-text">Upload Now</span>
                        </button>
                    </form>
                </div>
            </div>

            <script>
                function openSpaceUpload(spaceId, spaceName) {
                    const modal = document.getElementById('spaceUploadModal');
                    const form = document.getElementById('spaceUploadForm');
                    const title = document.getElementById('spaceUploadTitle');
                    const desc = document.getElementById('spaceUploadDesc');

                    // Reset UI for file input
                    const dropzoneContent = document.getElementById('space-dropzone-content');
                    const filenameDisplay = document.getElementById('space-filename-display');
                    const fileInput = document.getElementById('space-dropzone-file');
                    if (fileInput) fileInput.value = '';
                    if (dropzoneContent) dropzoneContent.classList.remove('hidden');
                    if (filenameDisplay) filenameDisplay.classList.add('hidden');

                    form.action = `/upload-public-space/${spaceId}`;
                    if (title) title.textContent = `Share with ${spaceName}`;
                    if (desc) desc.textContent = `This file will only be visible to ${spaceName}.`;
                    modal.classList.remove('hidden');
                }

                function showToast(message, type = 'success') {
                    const toast = document.createElement('div');
                    const bgClass = type === 'success' ? 'bg-green-600' : 'bg-red-600';
                    const iconClass = type === 'success' ? 'ri-checkbox-circle-fill' : 'ri-error-warning-fill';
                    const textClass = type === 'success' ? 'text-green-200' : 'text-red-200';
                    const bgIconClass = type === 'success' ? 'bg-green-700' : 'bg-red-700';

                    toast.className = `fixed top-5 left-1/2 -translate-x-1/2 z-[200] flex items-center w-full max-w-xs p-4 text-white ${bgClass} rounded-lg shadow-xl transition-opacity duration-500 opacity-0`;
                    toast.innerHTML = `
                <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 ${textClass} ${bgIconClass} rounded-lg">
                    <i class="${iconClass}"></i>
                </div>
                <div class="ms-3 text-sm font-normal">${message}</div>
                <button type="button" onclick="this.parentElement.remove()" class="ms-auto -mx-1.5 -my-1.5 ${bgClass} ${textClass} hover:text-white p-1.5 inline-flex items-center justify-center h-8 w-8">
                    <i class="ri-close-line"></i>
                </button>
            `;

                    document.body.appendChild(toast);
                    requestAnimationFrame(() => {
                        toast.classList.remove('opacity-0');
                    });

                    setTimeout(() => {
                        toast.classList.add('opacity-0');
                        setTimeout(() => toast.remove(), 500);
                    }, 3000);
                }

                async function deleteFile(fileId, element) {
                    if (confirm('Are you sure you want to delete this file?')) {
                        try {
                            const response = await fetch(`/delete/${fileId}`, {
                                method: 'DELETE'
                            });
                            const result = await response.json();
                            if (result.success) {
                                element.closest('.glass-card').remove();
                                showToast(result.message || 'File deleted successfully', 'success');
                            } else {
                                showToast(result.message || 'Failed to delete file.', 'error');
                            }
                        } catch (error) {
                            console.error('Error deleting file:', error);
                            showToast('An error occurred while deleting the file.', 'error');
                        }
                    }
                }

                async function deletePublicFile(spaceId, fileId, element) {
                    if (confirm('Are you sure you want to delete this file?')) {
                        try {
                            const response = await fetch(`/delete-public-file/${spaceId}/${fileId}`, {
                                method: 'DELETE'
                            });
                            const result = await response.json();
                            if (result.success) {
                                const card = element.closest('.glass-card');
                                const container = card.parentElement;
                                card.remove();

                                if (container.children.length === 0) {
                                    container.innerHTML = `
                                <div class="flex flex-col items-center justify-center h-full text-white/40">
                                    <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                                    <p class="text-xl">No public files available yet.</p>
                                </div>`;
                                }
                                showToast(result.message || 'File deleted successfully', 'success');
                            } else {
                                showToast(result.message || 'Failed to delete file.', 'error');
                            }
                        } catch (error) {
                            console.error('Error deleting file:', error);
                            showToast('An error occurred while deleting the file.', 'error');
                        }
                    }
                }

                async function deleteSpace(spaceId) {
                    const currentUserId = '<%= user ? user._id.toString() : "" %>';
                    const spaceEl = document.querySelector(`[data-space-id="${spaceId}"]`);

                    if (spaceEl && spaceEl.dataset.ownerId) {
                        if (currentUserId !== spaceEl.dataset.ownerId) {
                            showToast('Unauthorized: You can only delete your own spaces.', 'error');
                            return;
                        }
                    }

                    if (confirm('Are you sure you want to delete this space and all its files?')) {
                        try {
                            const response = await fetch(`/delete-public-space/${spaceId}`, {
                                method: 'DELETE'
                            });
                            const result = await response.json();
                            if (result.success) {
                                const el = document.querySelector(`[data-space-id="${spaceId}"]`);
                                if (el) {
                                    const container = el.parentElement;
                                    el.remove();
                                    if (container.children.length === 0) {
                                        container.innerHTML = `
                                    <div class="text-center text-white/50 py-10">
                                        <i class="ri-folder-add-line text-5xl mb-3 block opacity-50"></i>
                                        <p>No user spaces created yet. Be the first!</p>
                                    </div>`;
                                    }
                                }
                                showToast(result.message || 'Space deleted successfully', 'success');
                            } else {
                                showToast(result.message || 'Failed to delete space.', 'error');
                            }
                        } catch (error) {
                            console.error('Error deleting space:', error);
                            showToast('An error occurred while deleting the space.', 'error');
                        }
                    }
                }

                document.addEventListener('DOMContentLoaded', () => {
                    const hideElement = (id) => {
                        const el = document.getElementById(id);
                        if (el) {
                            setTimeout(() => {
                                el.style.transition = 'opacity 0.5s ease';
                                el.style.opacity = '0';
                                setTimeout(() => el.remove(), 500);
                            }, 4000);
                        }
                    };
                    hideElement('toast-error');
                    hideElement('toast-success');
                });

                document.addEventListener('DOMContentLoaded', () => {
                    const navContainer = document.getElementById('main-nav-container');
                    const popUp = document.getElementById('popup');
                    const menuBtn = document.getElementById('menu-btn');
                    const mobileMenu = document.getElementById('mobile-menu');

                    const handleScroll = () => {
                        if (mobileMenu && mobileMenu.classList.contains('open')) {
                            navContainer.classList.add('nav-hide-bg');
                        } else if (window.scrollY > 10) {
                            navContainer.classList.add('nav-scrolled');
                            navContainer.classList.remove('nav-hide-bg');
                        } else {
                            navContainer.classList.remove('nav-scrolled');
                            navContainer.classList.remove('nav-hide-bg');
                        }
                    };

                    function updateMenuIcon(isOpen) {
                        const ic = document.getElementById('menu-icon');
                        if (!ic) return;
                        ic.className = isOpen ? 'ph-bold ph-x text-3xl' : 'ph-bold ph-list text-3xl';
                    }
                    function openMenu() {
                        mobileMenu.classList.add('open');
                        setTimeout(() => { navContainer.classList.add('nav-hide-bg'); }, 0);
                        updateMenuIcon(true);
                        document.body.style.overflow = 'hidden';
                    }
                    function closeMenu() {
                        mobileMenu.classList.remove('open');
                        navContainer.classList.remove('nav-hide-bg');
                        updateMenuIcon(false);
                        document.body.style.overflow = '';
                    }

                    menuBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (mobileMenu.classList.contains('open')) closeMenu(); else openMenu();
                    });

                    document.addEventListener('pointerdown', (e) => {
                        if (!mobileMenu.classList.contains('open')) return;
                        if (mobileMenu.contains(e.target) || menuBtn.contains(e.target)) return;
                        closeMenu();
                    });

                    window.addEventListener('scroll', handleScroll);
                    handleScroll();

                    function setActiveNav() {
                        const anchors = document.querySelectorAll('a.nav-link');
                        const currentPath = window.location.pathname;
                        anchors.forEach(a => {
                            try {
                                const aPath = new URL(a.href, location.origin).pathname;
                                if (aPath === currentPath) {
                                    a.classList.add('active');
                                    a.setAttribute('aria-current', 'page');
                                }
                            } catch (e) { }
                        });
                    }
                    setActiveNav();

                    window.showPopUp = () => {
                        popUp.classList.remove('hidden');
                        setTimeout(() => { popUp.classList.remove('opacity-0'); }, 10);
                    };
                    window.hidePopUp = () => {
                        popUp.classList.add('opacity-0');
                        // Reset any selected file state in popup
                        try {
                            const df = document.getElementById('dropzone-file-global');
                            const dcontent = document.getElementById('dropzone-content-global');
                            const fdisplay = document.getElementById('filename-display-global');
                            const fname = document.getElementById('file-name-text-global');
                            if (df) df.value = '';
                            if (fdisplay) fdisplay.classList.add('hidden');
                            if (dcontent) dcontent.classList.remove('hidden');
                            if (fname) fname.textContent = '';
                        } catch (err) { }
                        setTimeout(() => { popUp.classList.add('hidden'); }, 300);
                    };

                    const openUploadBtn = document.getElementById('open-upload-btn');
                    if (openUploadBtn) openUploadBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        window.showPopUp();
                    });

                    // Global popup dropzone filename preview
                    const dropzoneInputGlobal = document.getElementById('dropzone-file-global');
                    const dropzoneContentGlobal = document.getElementById('dropzone-content-global');
                    const filenameDisplayGlobal = document.getElementById('filename-display-global');
                    const fileNameTextGlobal = document.getElementById('file-name-text-global');

                    if (dropzoneInputGlobal) {
                        dropzoneInputGlobal.addEventListener('change', () => {
                            if (dropzoneInputGlobal.files.length > 0) {
                                if (dropzoneContentGlobal) dropzoneContentGlobal.classList.add('hidden');
                                if (filenameDisplayGlobal) filenameDisplayGlobal.classList.remove('hidden');
                                const fileNames = Array.from(dropzoneInputGlobal.files).map(f => f.name).join(', ');
                                if (fileNameTextGlobal) fileNameTextGlobal.textContent = `${dropzoneInputGlobal.files.length} file(s) selected: ${fileNames}`;
                            }
                        });
                    }

                    // Space popup dropzone filename preview
                    const spaceDropzoneInput = document.getElementById('space-dropzone-file');
                    const spaceDropzoneContent = document.getElementById('space-dropzone-content');
                    const spaceFilenameDisplay = document.getElementById('space-filename-display');
                    const spaceFileNameText = document.getElementById('space-file-name-text');

                    if (spaceDropzoneInput) {
                        spaceDropzoneInput.addEventListener('change', () => {
                            if (spaceDropzoneInput.files.length > 0) {
                                if (spaceDropzoneContent) spaceDropzoneContent.classList.add('hidden');
                                if (spaceFilenameDisplay) spaceFilenameDisplay.classList.remove('hidden');
                                const fileNames = Array.from(spaceDropzoneInput.files).map(f => f.name).join(', ');
                                if (spaceFileNameText) spaceFileNameText.textContent = `${spaceDropzoneInput.files.length} file(s) selected: ${fileNames}`;
                            }
                        });
                    }

                    const globalUploadForm = document.getElementById('globalUploadForm');
                    if (globalUploadForm) {
                        globalUploadForm.addEventListener('submit', () => {
                            const submitBtn = globalUploadForm.querySelector('button[type="submit"]');
                            if (submitBtn) {
                                setTimeout(() => {
                                    submitBtn.disabled = true;
                                    submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin text-xl btn-icon-anim"></i><span class="btn-text">Uploading...</span>';
                                }, 0);
                            }
                        });
                    }

                });

                document.addEventListener('DOMContentLoaded', () => {
                    const createSpaceBtn = document.getElementById('create-space-btn');
                    const createSpaceModal = document.getElementById('createSpaceModal');
                    const createSpaceForm = document.getElementById('create-space-form');
                    const spacesContainer = document.getElementById('spaces-container');

                    // Search controls
                    const searchForm = document.getElementById('space-search-form');
                    const searchInput = document.getElementById('space-search-input');
                    const searchReset = document.getElementById('space-search-reset');
                    const searchMsg = document.getElementById('space-search-msg');

                    // Fetch all public spaces on load to ensure visibility for all users
                    window.addEventListener('pageshow', () => {
                        fetchPublicSpaces();
                    });

                    async function fetchPublicSpaces() {
                        try {
                            const response = await fetch(`/get-public-spaces?t=${Date.now()}`);
                            const result = await response.json();
                            if (result.success) {
                                let newHtml = '';
                                if (result.spaces && result.spaces.length > 0) {
                                    newHtml = result.spaces.map(space => createSpaceElement(space)).join('');
                                } else {
                                    newHtml = `
                                <div class="text-center text-white/50 py-10">
                                    <i class="ri-folder-add-line text-5xl mb-3 block opacity-50"></i>
                                    <p>No user spaces created yet. Be the first!</p>
                                </div>`;
                                }
                                spacesContainer.innerHTML = newHtml;
                            }
                        } catch (error) {
                            console.error('Error fetching spaces:', error);
                        }
                    }

                    function showAllSpaces() {
                        if (!spacesContainer) return;
                        spacesContainer.querySelectorAll('[data-space-id]').forEach(c => c.style.display = '');
                        if (searchMsg) searchMsg.textContent = '';
                    }

                    function performSearch() {
                        if (!spacesContainer || !searchInput) return showAllSpaces();
                        const q = searchInput.value.trim();
                        if (!q) return showAllSpaces();
                        const normalized = q.toLowerCase();
                        let found = 0;
                        spacesContainer.querySelectorAll('[data-space-name]').forEach(card => {
                            const name = (card.dataset.spaceName || '').toLowerCase();
                            if (name.includes(normalized)) {
                                card.style.display = '';
                                found++;
                            } else {
                                card.style.display = 'none';
                            }
                        });
                        if (searchMsg) searchMsg.textContent = found === 0 ? 'No space found with that name.' : '';
                    }

                    if (searchForm) {
                        searchForm.addEventListener('submit', (e) => {
                            e.preventDefault();
                            performSearch();
                        });
                    }

                    if (searchReset) {
                        searchReset.addEventListener('click', () => {
                            const originalContent = searchReset.innerHTML;
                            searchReset.disabled = true;
                            searchReset.innerHTML = '<i class="ri-loader-4-line animate-spin text-xl btn-icon-anim"></i><span class="btn-text">Loading...</span>';
                            setTimeout(() => {
                                if (searchInput) searchInput.value = '';
                                showAllSpaces();
                                searchReset.innerHTML = originalContent;
                                searchReset.disabled = false;
                            }, 300);
                        });
                    }

                    if (createSpaceBtn) {
                        createSpaceBtn.addEventListener('click', () => {
                            const originalContent = createSpaceBtn.innerHTML;
                            createSpaceBtn.disabled = true;
                            createSpaceBtn.innerHTML = '<i class="ri-loader-4-line animate-spin text-xl btn-icon-anim"></i><span class="btn-text">Loading...</span>';
                            setTimeout(() => {
                                createSpaceModal.classList.remove('hidden');
                                createSpaceBtn.innerHTML = originalContent;
                                createSpaceBtn.disabled = false;
                            }, 300);
                        });
                    }

                    if (createSpaceForm) {
                        createSpaceForm.addEventListener('submit', async (e) => {
                            e.preventDefault();

                            if (createSpaceForm.dataset.submitting === 'true') return;
                            createSpaceForm.dataset.submitting = 'true';

                            const submitBtn = createSpaceForm.querySelector('button[type="submit"]');
                            const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';

                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin text-xl btn-icon-anim"></i><span class="btn-text">Creating...</span>';
                            }

                            const formData = new FormData(createSpaceForm);
                            const data = Object.fromEntries(formData.entries());

                            // Handle checkboxes explicitly to ensure false is sent when unchecked
                            data.allowUploads = createSpaceForm.querySelector('input[name="allowUploads"]').checked;
                            data.allowDownloads = createSpaceForm.querySelector('input[name="allowDownloads"]').checked;

                            try {
                                const response = await fetch('/create-public-space', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(data)
                                });

                                const result = await response.json();

                                if (result.success) {
                                    const newSpaceElement = createSpaceElement(result.space);
                                    spacesContainer.insertAdjacentHTML('beforeend', newSpaceElement);
                                    // If user has an active search, reapply the filter so the listing respects it
                                    if (searchInput && searchInput.value.trim() !== '') {
                                        performSearch();
                                    }

                                    // Scroll to and highlight the new space
                                    const createdEl = spacesContainer.querySelector(`[data-space-id="${result.space._id}"]`);
                                    if (createdEl) {
                                        createdEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                        createdEl.classList.add('created-highlight'); // Ensure this class exists in CSS or add inline style if needed, assuming it's in global CSS
                                        setTimeout(() => createdEl.classList.remove('created-highlight'), 3000);
                                    }

                                    createSpaceModal.classList.add('hidden');
                                    createSpaceForm.reset();
                                    showToast('Space created successfully!', 'success');
                                } else {
                                    showToast(result.message || 'Failed to create space.', 'error');
                                }
                            } catch (error) {
                                console.error('Error creating space:', error);
                                showToast('An error occurred while creating the space.', 'error');
                            } finally {
                                createSpaceForm.dataset.submitting = 'false';
                                if (submitBtn) {
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = originalBtnContent;
                                }
                            }
                        });
                    }

                    const spaceUploadForm = document.getElementById('spaceUploadForm');
                    if (spaceUploadForm) {
                        spaceUploadForm.addEventListener('submit', async (e) => {
                            e.preventDefault();
                            const formData = new FormData(spaceUploadForm);
                            const action = spaceUploadForm.action;
                            const spaceId = action.split('/').pop();

                            const submitBtn = spaceUploadForm.querySelector('button[type="submit"]');
                            const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';
                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin text-xl btn-icon-anim"></i><span class="btn-text">Uploading...</span>';
                            }

                            try {
                                const response = await fetch(action, {
                                    method: 'POST',
                                    body: formData,
                                });
                                const result = await response.json();

                                if (result.success) {
                                    const spaceCard = document.querySelector(`[data-space-id="${spaceId}"]`);
                                    if (spaceCard) {
                                        const filesContainer = spaceCard.querySelector('.glass-panel-light');
                                        // Remove "No files" message if it exists
                                        const noFilesMsg = filesContainer.querySelector('.flex.flex-col.items-center');
                                        if (noFilesMsg) noFilesMsg.remove();

                                        const newFileElement = createFileElement(result.file, spaceId);
                                        filesContainer.insertAdjacentHTML('afterbegin', newFileElement);
                                    }

                                    showToast(result.message, 'success');
                                    document.getElementById('spaceUploadModal').classList.add('hidden');
                                    spaceUploadForm.reset();
                                } else {
                                    showToast(result.message || 'Upload failed.', 'error');
                                }
                            } catch (error) {
                                console.error('Upload error:', error);
                                showToast('An error occurred during upload.', 'error');
                            } finally {
                                if (submitBtn) {
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = originalBtnContent;
                                }
                            }
                        });
                    }

                    function createSpaceElement(space) {
                        const ownerId = space.owner ? (space.owner._id || space.owner).toString() : '';
                        const ownerName = space.ownerUsername || (space.owner && space.owner.username) ? (space.owner.username || space.ownerUsername) : 'Unknown';

                        const currentUserId = '<%= user ? user._id.toString() : "" %>';
                        const isOwner = currentUserId && ownerId && currentUserId === ownerId;

                        // Use truthy checks for plural field names
                        const downloadsAllowed = !!space.allowDownloads;
                        const uploadsAllowed = !!space.allowUploads;

                        const canDownload = isOwner || downloadsAllowed;
                        const canUpload = isOwner || uploadsAllowed;

                        let actionButtons = `
                `;

                        if (canDownload) {
                            actionButtons += `<a href="/download-public-space-all/${space._id}" title="Download All" class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-download-line text-xl"></i></a>`;
                        }

                        if (canUpload) {
                            actionButtons += `<button data-space-id="${space._id}" data-space-name="${space.name}" onclick="openSpaceUpload(this.dataset.spaceId, this.dataset.spaceName)" title="Upload" class="flex-shrink-0 bg-white/10 hover:bg-blue-500 hover:text-white text-blue-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-upload-cloud-2-line"></i></button>`;
                        }

                        if (isOwner) {
                            actionButtons += `<button data-space-id="${space._id}" onclick="deleteSpace(this.dataset.spaceId)" title="Delete" class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-delete-bin-line text-xl"></i></button>`;
                        }

                        let filesHtml = '';
                        if (space.files && space.files.length > 0) {
                            filesHtml = space.files.map(file => createFileElement(file, space._id, ownerId, downloadsAllowed)).join('');
                        } else {
                            filesHtml = `
                        <div class="flex flex-col items-center justify-center h-full text-white/40">
                            <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                            <p class="text-xl">No public files available yet.</p>
                        </div>`;
                        }

                        return `
                <div class="glass-panel rounded-[2rem] p-8 relative overflow-hidden" data-space-id="${space._id}" data-space-name="${space.name}" data-owner-id="${ownerId}" data-allow-downloads="${downloadsAllowed}">
                    <div class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center gap-4 mb-8">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white/10 rounded-2xl flex items-center justify-center border-white-500/30">
                                <i class="ri-folder-3-line text-2xl text-white/60"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-white flex items-center gap-2">
                                    ${space.name}
                                </h3>
                                <p class="text-sm text-white/60">Created by <span class="font-medium">@${ownerName}</span></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            ${actionButtons}
                        </div>
                    </div>
                    <div class="glass-panel-light rounded-2xl h-[250px] overflow-y-auto custom-scrollbar py-4 space-y-3">
                        ${filesHtml}
                    </div>
                </div>
                `;
                    }

                    function createFileElement(file, spaceId, providedSpaceOwnerId = null, providedAllowDownloads = null) {
                        let spaceOwnerId = providedSpaceOwnerId;
                        let allowDownloads = providedAllowDownloads;

                        if (!spaceOwnerId || allowDownloads === null) {
                            const spaceCard = document.querySelector(`[data-space-id="${spaceId}"]`);
                            if (spaceCard) {
                                if (!spaceOwnerId) spaceOwnerId = spaceCard.dataset.ownerId;
                                if (allowDownloads === null) allowDownloads = spaceCard.dataset.allowDownloads !== 'false';
                            }
                        }
                        // Default to true if we still don't know (fallback)
                        if (allowDownloads === null) allowDownloads = true;

                        const currentUserId = '<%= user ? user._id : "" %>';
                        const fileOwnerId = file.owner._id || file.owner;

                        const isFileOwner = currentUserId && fileOwnerId && currentUserId === fileOwnerId.toString();

                        // Check if current user can delete (is file owner OR space owner)
                        const canDelete = currentUserId && (currentUserId === fileOwnerId.toString() || currentUserId === spaceOwnerId);
                        const canDownload = allowDownloads || (currentUserId && currentUserId === spaceOwnerId);
                        const downloadTitle = (!allowDownloads && currentUserId === spaceOwnerId) ? "Download (Owner Access)" : "Download";
                        return `
                    <div class="glass-card flex items-center justify-between p-4 rounded-xl group">
                        <div class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-white/10 flex items-center justify-center text-cyan-300">
                                <i class="ri-file-line text-xl"></i>
                            </div>
                            <div class="truncate">
                                <a href="/view-public/${file.s3Key}" class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                    ${file.originalName}
                                </a>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="text-sm font-medium text-blue-200/70">
                                        @${file.owner && file.owner.username ? file.owner.username : 'Unknown'}
                                    </span>
                                    ${file.size ? `<span class="text-xs text-blue-200/70">• ${(file.size / 1024 / 1024).toFixed(2)} MB</span>` : ''}
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            ${(canDownload && !isFileOwner) ? `
                                <a href="/download-public/${file.s3Key}" download="${file.originalName}" title="${downloadTitle}" class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-download-line text-xl"></i></a>
                            ` : ''}
                            ${canDelete ? `
                                <button onclick="deletePublicFile('${spaceId}', '${file._id}', this)" title="Delete" class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                    <i class="ri-delete-bin-line text-xl"></i>
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `;
                    }
                });
            </script>
            <%- include('partials/footer') %>