<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Upload Status</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    
    <!-- Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Modern Gradient Background matching Home/Login/Register */
        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .glass-inner {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>

<body class="animated-bg flex items-center justify-center p-4">

    <!-- Glass Container -->
    <div class="glass-panel w-full max-w-md p-8 rounded-2xl shadow-2xl relative overflow-hidden text-center">
        
        <%# 
            This is the main logic of the page.
            We check if a 'file' object was sent from the server.
            The server only sends this object after a file has been successfully uploaded.
        %>
        <% if (typeof file !== 'undefined' && file) { %>
            
            <%# --- DISPLAY UPLOADED FILE INFO --- %>
            <%# If the 'file' object exists, it means an upload was successful. %>
            
            <div class="mb-6 flex justify-center">
                <div class="w-20 h-20 rounded-full bg-green-500/20 flex items-center justify-center shadow-[0_0_15px_rgba(34,197,94,0.3)]">
                    <i class="ri-checkbox-circle-fill text-green-400 text-4xl"></i>
                </div>
            </div>

            <h1 class="text-2xl font-bold text-white mb-6">File Uploaded Successfully!</h1>
            
            <!-- File Details Card -->
            <div class="glass-inner rounded-xl p-6 mb-8 text-left space-y-3">
                <div class="flex items-start gap-3">
                    <div class="mt-1"><i class="ri-file-line text-cyan-300"></i></div>
                    <div class="overflow-hidden">
                        <p class="text-xs text-blue-200 uppercase tracking-wider font-semibold">File Name</p>
                        <p class="text-white text-sm truncate"><%= file.originalname %></p>
                    </div>
                </div>
                
                <div class="h-px bg-white/10 w-full my-2"></div>

                <div class="flex items-start gap-3">
                    <div class="mt-1"><i class="ri-file-settings-line text-cyan-300"></i></div>
                    <div>
                        <p class="text-xs text-blue-200 uppercase tracking-wider font-semibold">File Type</p>
                        <p class="text-white text-sm"><%= file.mimetype %></p>
                    </div>
                </div>

                <div class="h-px bg-white/10 w-full my-2"></div>

                <div class="flex items-start gap-3">
                    <div class="mt-1"><i class="ri-hard-drive-2-line text-cyan-300"></i></div>
                    <div>
                        <p class="text-xs text-blue-200 uppercase tracking-wider font-semibold">File Size</p>
                        <p class="text-white text-sm"><%= (file.size / 1024).toFixed(2) %> KB</p>
                    </div>
                </div>
            </div>

            <!-- Upload Another Button -->
            <a href="/home" 
                class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-white text-blue-900 px-5 py-3 font-bold shadow-lg shadow-blue-900/20 transition-all duration-300 
                hover:bg-transparent hover:border-white/70 hover:text-white hover:border-2 hover:shadow-none border-2 border-transparent">
                <i class="ri-upload-cloud-2-line"></i>
                <span>Upload Another File</span>
            </a>

        <% } else { %>

            <%# --- SHOW UPLOAD FORM (ERROR STATE) --- %>
            <%# If the 'file' object does NOT exist, it means we need to show the error/back state %>
            
            <div class="mb-6 flex justify-center">
                <div class="w-20 h-20 rounded-full bg-red-500/20 flex items-center justify-center shadow-[0_0_15px_rgba(239,68,68,0.3)]">
                    <i class="ri-close-circle-fill text-red-400 text-4xl"></i>
                </div>
            </div>

            <h2 class="text-2xl font-bold text-white mb-2">Oops!</h2>
            <p class="text-blue-100 mb-8">You haven't selected a File yet</p>
            
            <!-- Go Back Button (Implemented as 'a' tag as requested) -->
            <a href="/home" 
                class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-white text-blue-900 px-5 py-3 font-bold shadow-lg shadow-blue-900/20 transition-all duration-300 
                hover:bg-transparent hover:border-white/70 hover:text-white hover:border-2 hover:shadow-none border-2 border-transparent">
                <i class="ri-arrow-left-line"></i>
                <span>Go Back</span>
            </a>

        <% } %>
    </div>

</body>
</html>