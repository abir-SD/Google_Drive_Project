<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Global Community Hub - Your Drive</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
            position: relative;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

         /* Dynamic Navbar Transition */
        #main-nav-container {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Mobile Menu Drawer Logic */
        #mobile-menu {
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #mobile-menu.open {
            transform: translateX(0);
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-0.5px);
            border-color: rgba(255, 255, 255, 0.3);
        }

        /* Navbar dynamic state - Exactly matching welcome.ejs */
        #main-nav-container {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-scrolled {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        /* Remove nav background/blur when menu is open */
        .nav-hide-bg {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom-color: transparent !important;
            box-shadow: none !important;
        }

        /* Nav Link Underline - Exactly matching welcome.ejs */
        .nav-link {
            position: relative;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dbeafe;
            transition: color 0.3s ease;
        }
        
        .nav-link:hover, .nav-link.active {
            color: #67e8f9;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 50%;
            background-color: #67e8f9;
            transition: all 0.3s ease-in-out;
            transform: translateX(-50%);
        }

        .nav-link:hover::after, .nav-link.active::after {
            width: 100%;
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 10px; }
    </style>
</head>

<body class="animated-bg text-white flex flex-col">

    <nav class="fixed top-0 w-full z-50 px-4">
        <div id="main-nav-container" class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4 rounded-b-xl border-b border-transparent bg-transparent">
            <!-- Brand -->
            <a href="/welcome" class="flex items-center gap-2 relative z-[60]">
                <i class="ph-fill ph-cloud-arrow-up text-cyan-300 text-2xl"></i>
                <span class="font-bold tracking-tight text-xl">Your Drive</span>
            </a>

            <!-- Desktop Links Group (Hidden on small) -->
            <div class="hidden md:flex items-center gap-6 md:gap-8">
                <a href="/home" class="nav-link">
                    <i class="ph ph-user text-cyan-300"></i>
                    <span>Personal</span>
                </a>

                <a href="/global" class="nav-link">
                    <i class="ph ph-globe text-cyan-300"></i>
                    <span>Global</span>
                </a>

                <a href="/about" class="nav-link">
                    <i class="ph ph-info text-cyan-300"></i>
                    <span>About</span>
                </a>

                <div class="w-px h-6 bg-white/10 mx-1"></div>

                <a href="/members" class="nav-link">
                    <i class="ph-bold ph-users-three text-cyan-300"></i>
                    <span>Community</span>
                </a>
            </div>

            <!-- Hamburger Button (Mobile Only) -->
            <button id="menu-btn" class="md:hidden relative z-[60] p-2 text-cyan-300 focus:outline-none" aria-label="Open menu" aria-expanded="false">
                <i id="menu-icon" class="ph-bold ph-list text-3xl"></i>
            </button>
        </div>

        <!-- Mobile Side Menu Overlay -->
        <div id="mobile-menu" class="fixed inset-y-0 right-0 w-[280px] glass-panel z-50 md:hidden flex flex-col p-8 pt-28 shadow-2xl space-y-8">
            <a href="/home" class="nav-link text-lg">
                <i class="ph ph-user text-cyan-300 text-xl"></i>
                <span>Personal</span>
            </a>
            <a href="/global" class="nav-link text-lg">
                <i class="ph ph-globe text-cyan-300 text-xl"></i>
                <span>Global</span>
            </a>
            <a href="/about" class="nav-link text-lg">
                <i class="ph ph-info text-cyan-300 text-xl"></i>
                <span>About</span>
            </a>
            <div class="w-full h-px bg-white/10"></div>
            <a href="/members" class="nav-link text-lg">
                <i class="ph-bold ph-users-three text-cyan-300 text-xl"></i>
                <span>Community</span>
            </a>
        </div>
    </nav>

    <main class="flex-grow flex flex-col items-center px-4 pt-48 pb-10 relative z-10 w-full">
        
        <div class="w-full max-w-4xl space-y-8">
            <div class="text-center mb-8">
                <h1 class="text-4xl md:text-5xl font-bold tracking-tight flex items-center justify-center gap-3">
                    <i class="ri-global-line text-cyan-300"></i>
                    <span>Global Hub</span>
                </h1>
                <p class="text-blue-100 mt-2 text-lg font-light">Discover public files shared by the community</p>
            </div>

            <div class="glass-panel rounded-2xl shadow-2xl overflow-hidden p-1">
                <div class="max-h-[55vh] overflow-y-auto custom-scrollbar p-4 space-y-3">
                    <% if (files.length === 0) { %>
                        <div class="text-center py-20 text-white/40">
                            <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                            <p class="text-xl">No public files available yet.</p>
                        </div>
                    <% } %>

                    <% files.forEach(file => { %>
                        <div class="glass-card flex items-center justify-between p-4 rounded-xl group">
                            <div class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                                <div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center text-cyan-300">
                                    <i class="ri-file-line text-xl"></i>
                                </div>
                                <div class="truncate">
                                    <a href="/view-public/<%= file.s3Key %>" class="text-base font-semibold hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                        <%= file.originalName %>
                                    </a>
                                    <% if (file.size) { %>
                                        <span class="text-xs text-blue-200/50 block mt-0.5">
                                            <%= (file.size / 1024 / 1024).toFixed(2) %> MB
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                            <a href="/download-public/<%= file.s3Key %>" download="<%= file.originalName %>" 
                               class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                <i class="ri-download-line text-xl"></i>
                            </a>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-center items-center gap-5 mt-8">
                <button id="open-upload-btn" class="w-full sm:flex-1 rounded-full border-2 border-white/40 text-white px-8 py-3.5 font-bold transition-all duration-300 hover:bg-white hover:text-blue-900 flex items-center justify-center gap-2">
                    <i class="ri-upload-cloud-2-line text-xl"></i>
                    Upload Publicly
                </button>

                <a href="/logout" class="w-full sm:flex-1 rounded-full bg-white text-blue-900 px-8 py-3 font-bold shadow-xl transition-all duration-300 hover:bg-transparent hover:border-white hover:text-white border-2 border-transparent flex items-center justify-center gap-2">
                    <i class="ri-logout-box-r-line text-xl"></i>
                    Logout
                </a>
            </div>
        </div>
    </main>

    <div id="popup" class="fixed inset-0 z-[100] flex hidden items-center justify-center bg-black/60 opacity-0 backdrop-blur-sm p-4 transition-opacity duration-300">
        <div class="glass-panel w-full max-w-lg scale-95 transform rounded-2xl p-8 shadow-2xl relative">
             <button onclick="hidePopUp()" class="absolute top-4 right-4 text-white/70 hover:text-white">
                <i class="ri-close-line text-3xl"></i>
            </button>
            <div class="text-center mb-6">
                <h3 class="text-2xl font-bold text-white">Share Globally</h3>
                <p class="text-blue-200 text-sm">This file will be visible to everyone</p>
            </div>
            <form action="/upload-global" method="post" enctype="multipart/form-data">
                <label class="flex h-48 w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/30 bg-white/5 hover:bg-white/10">
                    <i class="ri-upload-cloud-line text-4xl text-cyan-300 mb-2"></i>
                    <span class="text-sm font-medium">Click to select file</span>
                    <input type="file" name="file" class="hidden" required />
                </label>
                <button type="submit" class="mt-6 w-full rounded-full bg-white text-blue-900 py-3 font-bold">Upload Now</button>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const navContainer = document.getElementById('main-nav-container');
            const popUp = document.getElementById('popup');
            const menuBtn = document.getElementById('menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuIcon = document.getElementById('menu-icon');

            const handleScroll = () => {
                if (mobileMenu && mobileMenu.classList.contains('open')) {
                    navContainer.classList.add('nav-hide-bg');
                } else if (window.scrollY > 10) {
                    navContainer.classList.add('nav-scrolled');
                    navContainer.classList.remove('nav-hide-bg');
                } else {
                    navContainer.classList.remove('nav-scrolled');
                    navContainer.classList.remove('nav-hide-bg');
                }
            };

            // Robust mobile menu open/close helpers (always re-query the icon to avoid stale references)
            function updateMenuIcon(isOpen) {
                const ic = document.getElementById('menu-icon');
                if (!ic) return;
                ic.className = isOpen ? 'ph-bold ph-x text-3xl' : 'ph-bold ph-list text-3xl';
                ic.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
                ic.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
            function openMenu() {
                mobileMenu.classList.add('open');
                setTimeout(() => { navContainer.classList.add('nav-hide-bg'); }, 0);
                updateMenuIcon(true);
                if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
                if (menuBtn) menuBtn.style.zIndex = '9999';
                document.body.style.overflow = 'hidden';
            }
            function closeMenu() {
                mobileMenu.classList.remove('open');
                navContainer.classList.remove('nav-hide-bg');
                updateMenuIcon(false);
                if (menuBtn) menuBtn.style.zIndex = '';
                document.body.style.overflow = '';
            }

            // Mobile Menu Toggle
            menuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (mobileMenu.classList.contains('open')) closeMenu(); else openMenu();
            });

            // Close when clicking / touching outside the menu
            document.addEventListener('pointerdown', (e) => {
                if (!mobileMenu.classList.contains('open')) return;
                if (mobileMenu.contains(e.target) || menuBtn.contains(e.target)) return;
                closeMenu();
            });

            // Close mobile menu on resize
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768 && mobileMenu.classList.contains('open')) {
                    closeMenu();
                }
            });

            window.addEventListener('scroll', handleScroll);
            handleScroll();

            // Active nav highlighting (desktop + mobile)
            function setActiveNav() {
                const anchors = document.querySelectorAll('a.nav-link');
                const currentPath = window.location.pathname;
                const redirectEl = document.getElementById('redirect-to');
                const targetPath = (redirectEl && redirectEl.dataset.target) ? redirectEl.dataset.target : currentPath;
                anchors.forEach(a => {
                    try {
                        const aPath = new URL(a.href, location.origin).pathname;
                        if (aPath === targetPath || (aPath !== '/' && targetPath.startsWith(aPath))) {
                            a.classList.add('active');
                            a.setAttribute('aria-current', 'page');
                        } else {
                            a.classList.remove('active');
                            a.removeAttribute('aria-current');
                        }
                    } catch (e) {}
                });
            }
            setActiveNav();

            window.showPopUp = () => {
                popUp.classList.remove('hidden');
                setTimeout(() => { popUp.classList.remove('opacity-0'); }, 10);
            };
            window.hidePopUp = () => {
                popUp.classList.add('opacity-0');
                setTimeout(() => { popUp.classList.add('hidden'); }, 300);
            };

            // Fallback: make sure the upload button opens popup even if inline onclick fails
            const openUploadBtn = document.getElementById('open-upload-btn');
            if (openUploadBtn) openUploadBtn.addEventListener('click', (e) => {
                e.preventDefault();
                if (typeof window.showPopUp === 'function') return window.showPopUp();
                const popUp = document.getElementById('popup');
                if (popUp) {
                    popUp.classList.remove('hidden');
                    setTimeout(() => { popUp.classList.remove('opacity-0'); }, 10);
                }
            });
        });
    </script>
</body>
</html>