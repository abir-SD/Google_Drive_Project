<% /* Server-set toasts: prefer the global showToast (Toastify) if available */ %>
<% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <script>document.addEventListener('DOMContentLoaded', () => { if (typeof showToast === 'function') showToast('<%= success_msg[0].replace(/'/g,"\\'") %>', 'success'); else console.log('SUCCESS: <%= success_msg[0] %>'); });</script>
<% } else if (typeof successMsg !== 'undefined' && successMsg) { %>
    <script>document.addEventListener('DOMContentLoaded', () => { if (typeof showToast === 'function') showToast('<%= successMsg.replace(/'/g,"\\'") %>', 'success'); else console.log('SUCCESS: <%= successMsg %>'); });</script>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <script>document.addEventListener('DOMContentLoaded', () => { if (typeof showToast === 'function') showToast('<%= error_msg[0].replace(/'/g,"\\'") %>', 'error'); else console.error('ERROR: <%= error_msg[0] %>'); });</script>
<% } else if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <script>document.addEventListener('DOMContentLoaded', () => { if (typeof showToast === 'function') showToast('<%= errorMsg.replace(/'/g,"\\'") %>', 'error'); else console.error('ERROR: <%= errorMsg %>'); });</script>
<% } %>
