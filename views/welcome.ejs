<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Drive - Secure Cloud Storage</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        /* Modern Gradient Background */
        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
            position: relative;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* Nav Link Underline */
        .nav-link {
            position: relative;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dbeafe;
            transition: color 0.3s ease;
        }
        
        .nav-link:hover {
            color: #67e8f9;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 50%;
            background-color: #67e8f9;
            transition: all 0.3s ease-in-out;
            transform: translateX(-50%);
        }
        .nav-link:hover::after {
            width: 100%;
        }

        /* Premium "Contact Sales" Style Button Interaction */
        .btn-premium {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* The Sliding Arrow */
        .btn-premium .btn-arrow {
            position: absolute;
            left: -20px;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 1.1rem;
        }

        /* The Button Text */
        .btn-premium .btn-text {
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Hover States for Arrows and Text */
        .btn-premium:hover .btn-arrow {
            left: 24px;
            opacity: 1;
        }

        .btn-premium:hover .btn-text {
            transform: translateX(10px);
        }

        /* --- RESTORED ORIGINAL COLORS --- */

        /* Sign In: Outline style */
        .btn-signin-style {
            border: 2px solid rgba(255, 255, 255, 0.4);
            color: white;
            background: transparent;
        }
        .btn-signin-style:hover {
            background-color: white;
            color: #1e3a8a; /* dark blue text on white bg */
            border-color: white;
        }

        /* Get Started: Solid style */
        .btn-getstarted-style {
            background-color: white;
            color: #1e3a8a; /* dark blue */
            border: 2px solid white;
        }
        .btn-getstarted-style:hover {
            background-color: transparent;
            color: white;
            border-color: white;
        }

        /* Floating Animation */
        .float-slow { animation: float 6s ease-in-out infinite; }
        .float-medium { animation: float 5s ease-in-out infinite; animation-delay: 1s; }

        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }

        .cloud {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 50px;
            position: absolute;
            z-index: 0;
            filter: blur(2px);
        }
        .cloud::after, .cloud::before {
            content: '';
            background: inherit;
            border-radius: 50%;
            position: absolute;
        }
    </style>
</head>
<body class="animated-bg text-white flex flex-col">

    <!-- Navigation Header -->
    <nav class="fixed top-0 w-full z-50 px-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between glass-panel px-6 py-3 rounded-b-xl shadow-xl border-t-0">
            <!-- Brand -->
            <a href="/welcome" class="flex items-center gap-2">
                <i class="ph-fill ph-cloud-arrow-up text-cyan-300 text-2xl"></i>
                <span class="font-bold tracking-tight text-xl">Your Drive</span>
            </a>

            <!-- Links Group -->
            <div class="flex items-center gap-6 md:gap-8">
                <a href="/home" class="nav-link">
                    <i class="ph ph-user text-cyan-300"></i>
                    <span>Personal</span>
                </a>

                <a href="/global" class="nav-link">
                    <i class="ph ph-globe text-cyan-300"></i>
                    <span>Global</span>
                </a>

                <a href="/about" class="nav-link">
                    <i class="ph ph-info text-cyan-300"></i>
                    <span>About</span>
                </a>

                <div class="w-px h-6 bg-white/10 mx-1 hidden md:block"></div>

                <a href="/members" class="nav-link">
                    <i class="ph-bold ph-users-three text-cyan-300"></i>
                    <span>Community</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow flex flex-col justify-center px-4 pt-32 pb-10 relative z-10 w-full">
        
        <!-- Background Decor elements -->
        <div class="cloud w-32 h-12 top-1/4 left-5 md:left-20 opacity-30 float-slow hidden sm:block">
            <style>.cloud:nth-child(1)::after { width: 40px; height: 40px; top: -20px; left: 10px; } .cloud:nth-child(1)::before { width: 50px; height: 50px; top: -30px; right: 10px; }</style>
        </div>
        <div class="cloud w-48 h-16 bottom-1/4 right-5 md:right-20 opacity-40 float-medium hidden sm:block">
            <style>.cloud:nth-child(2)::after { width: 60px; height: 60px; top: -30px; left: 15px; } .cloud:nth-child(2)::before { width: 70px; height: 70px; top: -45px; right: 15px; }</style>
        </div>

        <div class="text-center max-w-4xl w-full mx-auto">
            
            <div class="mb-12 space-y-6">
                <h2 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight drop-shadow-lg">
                    Store. Share. <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-blue-200">Access.</span>
                </h2>
                <p class="text-lg md:text-2xl text-blue-100 max-w-2xl mx-auto font-light leading-relaxed">
                    Securely upload and manage your files — anytime, anywhere.
                </p>
            </div>

            <!-- Central Visual (Glass Card) -->
            <div class="relative w-full max-w-lg mx-auto mb-16 h-64 md:h-80">
                <div class="glass-panel w-full h-full rounded-2xl flex flex-col p-4 relative z-20 transition-all duration-500">
                    <div class="flex gap-2 mb-4">
                        <div class="w-3 h-3 rounded-full bg-red-400"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                        <div class="w-3 h-3 rounded-full bg-green-400"></div>
                    </div>
                    
                    <div class="flex-1 grid grid-cols-3 gap-4 p-2 items-center">
                        <div class="bg-white/10 rounded-lg p-3 flex flex-col items-center justify-center gap-2 transition-transform duration-300 hover:scale-110 cursor-pointer h-32 md:h-40">
                            <i class="ph-fill ph-image text-4xl text-purple-300"></i>
                            <div class="h-2 w-16 bg-white/20 rounded"></div>
                        </div>
                        
                        <div class="bg-white/20 rounded-lg p-3 flex flex-col items-center justify-center gap-2 shadow-lg border border-white/30 relative transition-transform duration-300 hover:scale-110 cursor-pointer h-36 md:h-44 -mt-2">
                            <div class="absolute -top-2 -right-2 bg-blue-500 rounded-full p-1 shadow-lg">
                                <i class="ph-bold ph-check text-xs text-white"></i>
                            </div>
                            <i class="ph-fill ph-play-circle text-5xl text-cyan-300"></i>
                            <div class="h-2 w-20 bg-white/40 rounded mt-1"></div>
                        </div>
                        
                        <div class="bg-white/10 rounded-lg p-3 flex flex-col items-center justify-center gap-2 transition-transform duration-300 hover:scale-110 cursor-pointer h-32 md:h-40">
                            <i class="ph-fill ph-file-text text-4xl text-blue-300"></i>
                            <div class="h-2 w-16 bg-white/20 rounded"></div>
                        </div>
                    </div>
                </div>
                <div class="absolute -top-10 -left-10 w-24 h-24 bg-purple-500 rounded-full mix-blend-multiply filter blur-xl opacity-70"></div>
                <div class="absolute -bottom-10 -right-10 w-24 h-24 bg-cyan-500 rounded-full mix-blend-multiply filter blur-xl opacity-70"></div>
            </div>

            <!-- Buttons with Restored Colors + New Animation -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                <a href="/user/login" class="btn-premium btn-signin-style text-center w-48 px-8 py-3.5 rounded-full font-semibold shadow-xl">
                    <i class="ph-bold ph-arrow-right btn-arrow"></i>
                    <span class="btn-text">Sign In</span>
                </a>
                
                <a href="/user/register" class="btn-premium btn-getstarted-style text-center w-48 px-8 py-3.5 rounded-full font-bold shadow-xl">
                    <i class="ph-bold ph-arrow-right btn-arrow"></i>
                    <span class="btn-text">Get Started</span>
                </a>
            </div>

        </div>
    </main>
    
    <footer class="text-center py-6 text-white/40 text-sm relative z-10">
        &copy; 2025 Your Drive. All rights reserved.
    </footer>

</body>
</html>

