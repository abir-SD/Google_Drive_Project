<%- include('partials/header') %>
    <%- include('partials/toast') %>
        <%- include('partials/nav') %>

            <style>
                /* Floating Animation */
                .float-slow {
                    animation: float 6s ease-in-out infinite;
                }

                .float-medium {
                    animation: float 5s ease-in-out infinite;
                    animation-delay: 1s;
                }

                @keyframes float {
                    0% {
                        transform: translateY(0px);
                    }

                    50% {
                        transform: translateY(-20px);
                    }

                    100% {
                        transform: translateY(0px);
                    }
                }

                .cloud {
                    background: rgba(255, 255, 255, 0.8);
                    border-radius: 50px;
                    position: absolute;
                    z-index: 0;
                    filter: blur(2px);
                }

                .cloud::after,
                .cloud::before {
                    content: '';
                    background: inherit;
                    border-radius: 50%;
                    position: absolute;
                }

                .cloud:nth-child(1)::after {
                    width: 40px;
                    height: 40px;
                    top: -20px;
                    left: 10px;
                }

                .cloud:nth-child(1)::before {
                    width: 50px;
                    height: 50px;
                    top: -30px;
                    right: 10px;
                }

                .cloud:nth-child(2)::after {
                    width: 60px;
                    height: 60px;
                    top: -30px;
                    left: 15px;
                }

                .cloud:nth-child(2)::before {
                    width: 70px;
                    height: 70px;
                    top: -45px;
                    right: 15px;
                }
            </style>

            <!-- Main Content -->
            <main
                class="flex-grow flex flex-col justify-center px-4 pt-32 sm:pt-48 pb-10 relative z-10 w-full overflow-hidden">

                <div class="cloud w-32 h-12 top-1/4 left-5 md:left-20 opacity-30 float-slow hidden sm:block">
                </div>
                <div class="cloud w-48 h-16 bottom-1/4 right-5 md:right-20 opacity-40 float-medium hidden sm:block">
                </div>

                <div class="text-center max-w-4xl w-full mx-auto relative z-20">
                    <div class="mb-12 space-y-6">
                        <h2
                            class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight leading-tight drop-shadow-lg">
                            Store. Share. <span
                                class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-blue-200">Access.</span>
                        </h2>
                        <p
                            class="text-base sm:text-lg md:text-2xl text-blue-100 max-w-2xl mx-auto font-light leading-relaxed px-4">
                            Securely upload and manage your files — anytime, anywhere.
                        </p>
                    </div>

                    <div class="relative w-full max-w-lg mx-auto mb-16 px-4">
                        <div
                            class="glass-panel w-full aspect-[16/10] sm:aspect-[16/9] rounded-2xl flex flex-col p-4 sm:p-6 relative z-20 transition-all duration-500 shadow-2xl">
                            <div class="flex gap-2 mb-4">
                                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                            </div>
                            <div class="flex-1 grid grid-cols-3 gap-3 sm:gap-4 p-2 items-center">
                                <div
                                    class="bg-white/10 rounded-lg p-2 sm:p-3 flex flex-col items-center justify-center gap-2 transition-transform duration-300 hover:scale-105 cursor-pointer h-24 sm:h-32 md:h-40">
                                    <i class="ph-fill ph-image text-3xl sm:text-4xl text-purple-300"></i>
                                    <div class="h-1.5 sm:h-2 w-12 sm:w-16 bg-white/20 rounded"></div>
                                </div>
                                <div
                                    class="bg-white/20 rounded-lg p-2 sm:p-3 flex flex-col items-center justify-center gap-2 shadow-lg border border-white/30 relative transition-transform duration-300 hover:scale-105 cursor-pointer h-28 sm:h-36 md:h-44 -mt-2">
                                    <div
                                        class="absolute -top-1 -right-1 sm:-top-2 sm:-right-2 bg-blue-500 rounded-full p-1 shadow-lg">
                                        <i class="ph-bold ph-check text-[10px] sm:text-xs text-white"></i>
                                    </div>
                                    <i class="ph-fill ph-play-circle text-4xl sm:text-5xl text-cyan-300"></i>
                                    <div class="h-1.5 sm:h-2 w-16 sm:w-20 bg-white/40 rounded mt-1"></div>
                                </div>
                                <div
                                    class="bg-white/10 rounded-lg p-2 sm:p-3 flex flex-col items-center justify-center gap-2 transition-transform duration-300 hover:scale-105 cursor-pointer h-24 sm:h-32 md:h-40">
                                    <i class="ph-fill ph-file-text text-3xl sm:text-4xl text-blue-300"></i>
                                    <div class="h-1.5 sm:h-2 w-12 sm:w-16 bg-white/20 rounded"></div>
                                </div>
                            </div>
                        </div>
                        <div
                            class="absolute -top-6 -left-6 sm:-top-10 sm:-left-10 w-20 h-20 sm:w-24 sm:h-24 bg-purple-500 rounded-full mix-blend-multiply filter blur-xl opacity-50 sm:opacity-70">
                        </div>
                        <div
                            class="absolute -bottom-6 -right-6 sm:-bottom-10 sm:-right-10 w-20 h-20 sm:w-24 sm:h-24 bg-cyan-500 rounded-full mix-blend-multiply filter blur-xl opacity-50 sm:opacity-70">
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center justify-center gap-5 px-6">
                        <a href="/user/login"
                            class="btn-premium btn-signin-style text-center w-full sm:w-48 px-8 py-3.5 rounded-full font-semibold shadow-xl">
                            <i class="ph-bold ph-arrow-right btn-arrow"></i>
                            <span class="btn-text">Sign In</span>
                        </a>
                        <a href="/user/register"
                            class="btn-premium btn-getstarted-style text-center w-full sm:w-48 px-8 py-3.5 rounded-full font-bold shadow-xl">
                            <i class="ph-bold ph-arrow-right btn-arrow"></i>
                            <span class="btn-text">Get Started</span>
                        </a>
                    </div>
                </div>
            </main>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const navContainer = document.getElementById('main-nav-container');
                    const menuBtn = document.getElementById('menu-btn');
                    const mobileMenu = document.getElementById('mobile-menu');
                    const menuIcon = document.getElementById('menu-icon');

                    const handleScroll = () => {
                        if (mobileMenu.classList.contains('open')) {
                            navContainer.classList.add('nav-hide-bg');
                        } else if (window.scrollY > 10) {
                            navContainer.classList.add('nav-scrolled');
                            navContainer.classList.remove('nav-hide-bg');
                        } else {
                            navContainer.classList.remove('nav-scrolled', 'nav-hide-bg');
                        }
                    };

                    function updateMenuIcon(isOpen) {
                        menuIcon.className = isOpen ? 'ph-bold ph-x text-3xl' : 'ph-bold ph-list text-3xl';
                    }

                    function openMenu() {
                        mobileMenu.classList.add('open');
                        navContainer.classList.add('nav-hide-bg');
                        updateMenuIcon(true);
                        menuBtn.setAttribute('aria-expanded', 'true');

                        // Block scroll without removing scrollbar width
                        document.body.style.overflowY = 'hidden';
                    }

                    function closeMenu() {
                        mobileMenu.classList.remove('open');
                        navContainer.classList.remove('nav-hide-bg');
                        updateMenuIcon(false);
                        menuBtn.setAttribute('aria-expanded', 'false');

                        // Restore scroll
                        document.body.style.overflowY = 'auto';
                        handleScroll();
                    }

                    menuBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (mobileMenu.classList.contains('open')) closeMenu(); else openMenu();
                    });

                    document.addEventListener('pointerdown', (e) => {
                        if (!mobileMenu.classList.contains('open')) return;
                        if (mobileMenu.contains(e.target) || menuBtn.contains(e.target)) return;
                        closeMenu();
                    });

                    window.addEventListener('resize', () => {
                        if (window.innerWidth >= 768 && mobileMenu.classList.contains('open')) {
                            closeMenu();
                        }
                    });

                    window.addEventListener('scroll', handleScroll, { passive: true });
                    handleScroll();
                });
            </script>
            <%- include('partials/footer') %>