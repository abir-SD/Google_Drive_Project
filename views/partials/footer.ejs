<div style="text-align: center; padding: 20px; color: gray; font-size: 12px;">
    <p>⚠️ <strong>Notice:</strong> This is a student educational project for a web development course. 
    This is NOT the real Google Drive. Please do not enter sensitive data.</p>
</div>
<footer class="text-center py-6 text-white/40 text-sm relative z-10">
    &copy; 2025 Your Drive. All rights reserved.
</footer>
<script>
    document.addEventListener('DOMContentLoaded', function () {
            <% if (locals.success_msg && success_msg.length > 0) { %>
                <% success_msg.forEach(function (msg) { %>
        showToast('<%= msg %>', 'success');
                <% }); %>
            <% } %>
            <% if (locals.error_msg && error_msg.length > 0) { %>
                <% error_msg.forEach(function (msg) { %>
            showToast('<%= msg %>', 'error');
                <% }); %>
            <% } %>
        });
</script>
</body>

</html>