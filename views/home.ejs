<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Upload</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <style>
        .pop {
            transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
        }
    </style>
</head>

<body class="bg-gray-50">

    <div class="space-y-3 p-4 md:p-6 bg-gray-50 rounded-xl shadow-lg">
        <% files.forEach(file=> { %>
            <div class="
            flex items-center justify-between p-3 sm:p-4 border-b border-gray-200 
            rounded-lg bg-white
            shadow-md hover:shadow-lg transition duration-300 ease-in-out
            hover:bg-indigo-50
        ">

                <div class="flex-grow min-w-0 pr-4">
                    <div class="
                    text-base font-medium text-gray-800
                    truncate leading-snug 
                    sm:text-lg 
                    max-w-full
                ">
                        <%= file.originalName %>
                    </div>
                </div>

                <a href="/download/<%= file.s3Key %>" download="<%= file.originalName %>" class="
                    flex-shrink-0 
                    text-white bg-indigo-600 hover:bg-indigo-700 
                    p-2 rounded-full 
                    shadow-lg transition duration-150 ease-in-out 
                    focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2
                " title="Download <%= file.originalName %>">
                    <i class="ri-download-line text-xl leading-none"></i>
                </a>

            </div>
            <% }) %>
    </div>

    <main class="h-screen w-screen p-8">
        <div class="flex justify-between items-center">
            <div class="flex gap-4">
                <button onclick="showPopUp()"
                    class="rounded-md bg-blue-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600">
                    Upload File
                </button>
                <a href="/welcome"
                    class="rounded-md bg-red-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600">
                    Logout
                </a>
            </div>
        </div>

        <div id="popup"
            class="pop fixed inset-0 z-50 flex hidden items-center justify-center bg-black/30 opacity-0 backdrop-blur-sm">
            <button onclick="hidePopUp()" class="absolute top-8 right-8 text-white opacity-80 hover:opacity-100">
                <i class="ri-close-line text-4xl"></i>
            </button>
            <div
                class="w-full max-w-lg scale-95 transform rounded-xl bg-white p-6 shadow-xl transition-all">
                <form id="upload-form" action="/upload" method="post" enctype="multipart/form-data">
                    <div class="flex w-full items-center justify-center">
                        <label for="dropzone-file"
                            class="flex h-64 w-full cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 hover:bg-gray-100">
                            <div id="dropzone-content" class="flex flex-col items-center justify-center pt-5 pb-6">
                                <svg class="mb-4 h-8 w-8 text-gray-500" aria-hidden="true"
                                    xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 9.021C5.137 9.017 5.071 9 5 9a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2" />
                                </svg>
                                <p class="mb-2 text-sm text-gray-500"><span
                                        class="font-semibold">Click to upload</span> or drag and drop</p>
                                <p class="text-xs text-gray-500">SVG, PNG, JPG or GIF (MAX.
                                    800x400px)</p>
                            </div>
                            <div id="filename-display" class="hidden text-center text-gray-700">
                            </div>
                            <input id="dropzone-file" type="file" class="hidden" name="file" />
                        </label>
                    </div>
                    <button type="submit"
                        class="mt-6 w-full rounded-md bg-blue-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600">
                        Upload File
                    </button>
                </form>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const popUp = document.getElementById('popup');

            // --- Popup Logic ---
            window.showPopUp = () => {
                popUp.classList.remove('hidden');
                setTimeout(() => {
                    popUp.classList.remove('opacity-0');
                    popUp.querySelector('.transform').classList.remove('scale-95');
                }, 10);
            };

            const hidePopUp = window.hidePopUp = () => {
                popUp.classList.add('opacity-0');
                popUp.querySelector('.transform').classList.add('scale-95');
                setTimeout(() => {
                    popUp.classList.add('hidden');
                    // Reset drag and drop UI
                    resetDropzone();
                }, 300);
            };

            // --- Drag and Drop Logic ---
            const dropzoneLabel = document.querySelector('label[for="dropzone-file"]');
            const dropzoneInput = document.getElementById('dropzone-file');
            const dropzoneContent = document.getElementById('dropzone-content');
            const filenameDisplay = document.getElementById('filename-display');
            const uploadForm = document.getElementById('upload-form');

            const resetDropzone = () => {
                if (dropzoneInput) dropzoneInput.value = ''; // Clear file input
                if (dropzoneContent) dropzoneContent.classList.remove('hidden'); // Show original content
                if (filenameDisplay) filenameDisplay.classList.add('hidden'); // Hide filename
            };

            const handleFileSelect = (file) => {
                if (file) {
                    dropzoneContent.classList.add('hidden');
                    filenameDisplay.classList.remove('hidden');
                    filenameDisplay.textContent = `Selected file: ${file.name}`;
                }
            };

            if (dropzoneInput) {
                dropzoneInput.addEventListener('change', () => handleFileSelect(dropzoneInput.files[0]));
            }

            if (dropzoneLabel) {
                dropzoneLabel.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    dropzoneLabel.classList.add('bg-gray-200');
                });

                dropzoneLabel.addEventListener('dragleave', (e) => {
                    e.preventDefault();
                    dropzoneLabel.classList.remove('bg-gray-200');
                });

                dropzoneLabel.addEventListener('drop', (e) => {
                    e.preventDefault();
                    dropzoneLabel.classList.remove('bg-gray-200');

                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        dropzoneInput.files = files;
                        handleFileSelect(files[0]);
                    }
                });
            }

            // Reset form on submit to clear the UI for the next upload
            if (uploadForm) {
                uploadForm.addEventListener('submit', () => {
                    // Use setTimeout to allow form submission before resetting UI.
                    setTimeout(() => {
                        hidePopUp();
                    }, 100);
                });
            }
        });
    </script>
</body>

</html>