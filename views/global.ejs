<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Global Community Hub - Your Drive</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
            position: relative;
        }

        @keyframes gradient {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* --- PREMIUM BUTTON ANIMATIONS --- */
        .btn-premium {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-icon-anim {
            position: absolute;
            left: -20px;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-text {
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Desktop Hover Logic */
        @media (hover: hover) {
            .btn-premium:hover .btn-icon-anim {
                left: 24px;
                opacity: 1;
            }

            .btn-premium:hover .btn-text {
                transform: translateX(12px);
            }
        }

        /* Mobile/Touch Fallback (Visible Icons) */
        @media (pointer: coarse) {
            .btn-premium .btn-icon-anim {
                position: static;
                opacity: 1;
                margin-right: 10px;
            }

            .btn-premium .btn-text {
                transform: none !important;
            }
        }

        /* --- REST OF THE STYLES --- */
        #main-nav-container {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #mobile-menu {
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #mobile-menu.open {
            transform: translateX(0);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-0.5px);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .nav-scrolled {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .nav-hide-bg {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom-color: transparent !important;
            box-shadow: none !important;
        }

        .nav-link {
            position: relative;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dbeafe;
            transition: color 0.3s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #67e8f9;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 50%;
            background-color: #67e8f9;
            transition: all 0.3s ease-in-out;
            transform: translateX(-50%);
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 100%;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        .space-blur {
            filter: blur(15px);
            pointer-events: none;
            user-select: none;
        }
    </style>
</head>

<body class="animated-bg text-white flex flex-col">

    <nav class="fixed top-0 w-full z-50 px-4">
        <div id="main-nav-container"
            class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4 rounded-b-xl border-b border-transparent bg-transparent">
            <a href="/welcome" class="flex items-center gap-2 relative z-[60]">
                <i class="ph-fill ph-cloud-arrow-up text-cyan-300 text-2xl"></i>
                <span class="font-bold tracking-tight text-xl">Your Drive</span>
            </a>

            <div class="hidden md:flex items-center gap-6 md:gap-8">
                <a href="/home" class="nav-link">
                    <i class="ph ph-user text-cyan-300"></i>
                    <span>Personal</span>
                </a>
                <a href="/global" class="nav-link">
                    <i class="ph ph-globe text-cyan-300"></i>
                    <span>Global</span>
                </a>
                <a href="/space" class="nav-link">
                    <i class="ph ph-lock-key text-cyan-300"></i>
                    <span>Protected</span>
                </a>
                <a href="/about" class="nav-link">
                    <i class="ph ph-info text-cyan-300"></i>
                    <span>About</span>
                </a>
                <div class="w-px h-6 bg-white/10 mx-1"></div>
                <a href="/members" class="nav-link">
                    <i class="ph-bold ph-users-three text-cyan-300"></i>
                    <span>Community</span>
                </a>
            </div>

            <button id="menu-btn" class="md:hidden relative z-[60] p-2 text-cyan-300 focus:outline-none"
                aria-label="Open menu" aria-expanded="false">
                <i id="menu-icon" class="ph-bold ph-list text-3xl"></i>
            </button>
        </div>

        <div id="mobile-menu"
            class="fixed inset-y-0 right-0 w-[280px] glass-panel z-50 md:hidden flex flex-col p-8 pt-28 shadow-2xl space-y-8">
            <a href="/home" class="nav-link text-lg">
                <i class="ph ph-user text-cyan-300 text-xl"></i>
                <span>Personal</span>
            </a>
            <a href="/global" class="nav-link text-lg">
                <i class="ph ph-globe text-cyan-300 text-xl"></i>
                <span>Global</span>
            </a>
            <a href="/space" class="nav-link text-lg">
                <i class="ph ph-lock-key text-cyan-300 text-xl"></i>
                <span>Protected</span>
            </a>
            <a href="/about" class="nav-link text-lg">
                <i class="ph ph-info text-cyan-300 text-xl"></i>
                <span>About</span>
            </a>
            <div class="w-full h-px bg-white/10"></div>
            <a href="/members" class="nav-link text-lg">
                <i class="ph-bold ph-users-three text-cyan-300 text-xl"></i>
                <span>Community</span>
            </a>
        </div>
    </nav>

    <main class="flex-grow flex flex-col items-center px-4 pt-48 pb-10 relative z-10 w-full">
        <!-- Global Files Section -->
        <div class="w-full max-w-4xl space-y-8">
            <% if (locals.errorMsg) { %>
                <div id="toast-error"
                    class="flex items-center w-full p-4 mb-4 text-white bg-red-500/20 border border-red-500/50 rounded-xl shadow-lg backdrop-blur-md"
                    role="alert">
                    <div
                        class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-red-400 bg-white/10 rounded-lg">
                        <i class="ri-error-warning-line text-xl"></i>
                    </div>
                    <div class="ms-3 text-sm font-medium">
                        <%= errorMsg %>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()"
                        class="ms-auto -mx-1.5 -my-1.5 p-1.5 text-white/50 hover:text-white transition-colors">
                        <i class="ri-close-line"></i>
                    </button>
                </div>
                <% } %>

                    <% if (locals.successMsg) { %>
                        <div id="toast-success"
                            class="flex items-center w-full p-4 mb-4 text-white bg-green-500/20 border border-green-500/50 rounded-xl shadow-lg backdrop-blur-md"
                            role="alert">
                            <div
                                class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-green-400 bg-white/10 rounded-lg">
                                <i class="ri-checkbox-circle-line text-xl"></i>
                            </div>
                            <div class="ms-3 text-sm font-medium">
                                <%= successMsg %>
                            </div>
                            <button type="button" onclick="this.parentElement.remove()"
                                class="ms-auto -mx-1.5 -my-1.5 p-1.5 text-white/50 hover:text-white transition-colors">
                                <i class="ri-close-line"></i>
                            </button>
                        </div>
                        <% } %>
                            <div class="text-center mb-8">
                                <h1
                                    class="text-4xl md:text-5xl font-bold tracking-tight flex items-center justify-center gap-3">
                                    <i class="ri-global-line text-cyan-300"></i>
                                    <span>Global Hub</span>
                                </h1>
                                <p class="text-blue-100 mt-2 text-lg font-light">Discover public files shared by the
                                    community</p>
                            </div>

                            <div class="glass-panel rounded-2xl shadow-2xl overflow-hidden p-1">
                                <div class="h-[300px] overflow-y-auto custom-scrollbar p-4 space-y-3">
                                    <% if (files.length===0) { %>
                                        <div class="flex flex-col items-center justify-center h-full text-white/40">
                                            <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                                            <p class="text-xl">No public files available yet.</p>
                                        </div>
                                        <% } %>

                                            <% files.forEach(file=> { %>
                                                <div
                                                    class="glass-card flex items-center justify-between p-4 rounded-xl group">
                                                    <div class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                                                        <div
                                                            class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center text-cyan-300">
                                                            <i class="ri-file-line text-xl"></i>
                                                        </div>
                                                        <div class="truncate">
                                                            <a href="/view-public/<%= file.s3Key %>"
                                                                class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                                                <%= file.originalName %>
                                                            </a>

                                                            <div class="flex items-center gap-2 mt-0.5">
                                                                <span class="text-sm font-medium text-blue-200/70">
                                                                    @<%= file.owner ? file.owner.username : 'Unknown' %>
                                                                </span>
                                                                <% if (file.size) { %>
                                                                    <span class="text-xs text-blue-200/70">
                                                                        • <%= (file.size / 1024 / 1024).toFixed(2) %> MB
                                                                    </span>
                                                                    <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <!-- Action Buttons Container -->
                                                    <div class="flex items-center gap-3">
                                                        <% 
                                                        const isFileOwner = user && file.owner && (file.owner._id ? file.owner._id.toString() : file.owner.toString()) === user._id.toString();
                                                        if (!isFileOwner) { %>
                                                            <a href="/download-public/<%= file.s3Key %>"
                                                                download="<%= file.originalName %>" title="Download"
                                                                class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                                    class="ri-download-line text-xl"></i></a>
                                                        <% } %>
                                                        <% if (isFileOwner) { %>
                                                            <button onclick="deleteFile('<%= file._id %>', this)"
                                                                title="Delete"
                                                                class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110 cursor-pointer"><i
                                                                    class="ri-delete-bin-line text-xl"></i></button>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <% }) %>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row justify-center items-center gap-5 mt-8">
                                <button id="open-upload-btn"
                                    class="btn-premium w-full sm:flex-1 rounded-full border-2 border-white/40 text-white px-8 py-3.5 font-bold hover:bg-white hover:text-blue-900 hover:border-white transition-all duration-400">
                                    <i class="ri-upload-cloud-2-line text-xl btn-icon-anim"></i>
                                    <span class="btn-text">Upload to Global Hub</span>
                                </button>


                                <a href="/logout"
                                    class="btn-premium w-full sm:flex-1 rounded-full bg-white text-blue-900 px-8 py-3.5 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none text-center">
                                    <i class="ri-logout-box-r-line text-xl btn-icon-anim"></i>
                                    <span class="btn-text">logout</span>
                                </a>
                            </div>
        </div>

        <!-- User Space Files Section -->

        <div class="text-center mb-8">
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight flex items-center justify-center gap-3">
                <i class="ri-global-line text-cyan-300"></i>
                <span>User Hub</span>
            </h1>
            <p class="text-blue-100 mt-2 text-lg font-light">Discover public files shared by the
                community members</p>
        </div>

        <form id="space-search-form" class="flex flex-col sm:flex-row justify-center items-center gap-3">
            <div class="relative w-full max-w-md">
                <i
                    class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-white/50 text-xl pointer-events-none"></i>
                <input id="space-search-input" name="space" type="search" placeholder="Search space by name"
                    class="w-full bg-white/5 border border-white/10 rounded-full pl-12 pr-4 py-3 text-white placeholder:text-white/40 focus:outline-none focus:border-white/40" />
            </div>
            <button type="button" id="space-search-reset"
                class="btn-premium w-full sm:flex-1 rounded-full bg-white text-blue-900 px-4 py-2 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none">
                <i class="ri-loop-left-fill text-xl btn-icon-anim"></i>
                <span class="btn-text">Reset</span>
            </button>
            <button id="create-space-btn"
                class="btn-premium w-full sm:flex-1 rounded-full border-2 border-white/40 text-white px-4 py-2 font-bold hover:border-white/70 hover:text-blue-900 hover:bg-white hover:border-white transition-all duration-400">
                <i class="ri-folder-add-line text-xl btn-icon-anim"></i>
                <span class="btn-text">Create Space</span>
            </button>
        </form>

        <div id="spaces-container" class="w-full max-w-4xl space-y-8">
            <% if (locals.errorMsg) { %>
                <div id="toast-error"
                    class="flex items-center w-full p-4 mb-4 text-white bg-red-500/20 border border-red-500/50 rounded-xl shadow-lg backdrop-blur-md"
                    role="alert">
                    <div
                        class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-red-400 bg-white/10 rounded-lg">
                        <i class="ri-error-warning-line text-xl"></i>
                    </div>
                    <div class="ms-3 text-sm font-medium">
                        <%= errorMsg %>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()"
                        class="ms-auto -mx-1.5 -my-1.5 p-1.5 text-white/50 hover:text-white transition-colors">
                        <i class="ri-close-line"></i>
                    </button>
                </div>
                <% } %>

                    <% if (locals.successMsg) { %>
                        <div id="toast-success"
                            class="flex items-center w-full p-4 mb-4 text-white bg-green-500/20 border border-green-500/50 rounded-xl shadow-lg backdrop-blur-md"
                            role="alert">
                            <div
                                class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-green-400 bg-white/10 rounded-lg">
                                <i class="ri-checkbox-circle-line text-xl"></i>
                            </div>
                            <div class="ms-3 text-sm font-medium">
                                <%= successMsg %>
                            </div>
                            <button type="button" onclick="this.parentElement.remove()"
                                class="ms-auto -mx-1.5 -my-1.5 p-1.5 text-white/50 hover:text-white transition-colors">
                                <i class="ri-close-line"></i>
                            </button>
                        </div>
                        <% } %>
                            <% if (typeof publicSpaces !=='undefined' && publicSpaces && publicSpaces.length> 0) { %>
                                <% publicSpaces.forEach(space=> { %>
                                    <% const ownerId=space.owner ? (space.owner._id || space.owner).toString() : null;
                                        const isOwner=user && ownerId && user._id.toString()===ownerId;
                                        
                                        // Use truthy checks (!!) to be safe.
                                        const downloadsAllowed = !!space.allowDownloads; 
                                        const uploadsAllowed = !!space.allowUploads;

                                        const canDownload = isOwner || downloadsAllowed;
                                        const canUpload = isOwner || uploadsAllowed; %>
                                        <div class="glass-panel rounded-[2rem] p-8 relative overflow-hidden"
                                            data-space-id="<%= space._id %>" data-space-name="<%= space.name %>"
                                            data-allow-downloads="<%= downloadsAllowed %>" data-owner-id="<%= ownerId %>">
                                            <div
                                                class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center gap-4 mb-8">
                                                <div class="flex items-center gap-4">
                                                    <div
                                                        class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center border-white-500/30">
                                                        <i class="ri-folder-3-line text-2xl text-white/60"></i>
                                                    </div>
                                                    <div>
                                                        <h3
                                                            class="text-2xl font-bold text-white flex items-center gap-2">
                                                            <%= space.name %>
                                                        </h3>
                                                        <p class="text-sm text-white/60">Created by <span
                                                                class="font-medium">@<%= (space.owner &&
                                                                    space.owner.username) ? space.owner.username
                                                                    : 'Unknown' %></span></p>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-3">
                                                    <% if (canDownload) { %>
                                                        <a href="/download-public-space-all/<%= space._id %>" 
                                                           title="Download All" 
                                                           class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                            <i class="ri-download-line text-xl"></i>
                                                        </a>
                                                    <% } %>
                                                
                                                    <% if (canUpload) { %>
                                                        <button data-space-id="<%= space._id %>" 
                                                                data-space-name="<%= space.name %>" 
                                                                onclick="openSpaceUpload(this.dataset.spaceId, this.dataset.spaceName)" 
                                                                title="Upload" 
                                                                class="flex-shrink-0 bg-white/10 hover:bg-blue-500 hover:text-white text-blue-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                            <i class="ri-upload-cloud-2-line"></i>
                                                        </button>
                                                    <% } %>
                                                    
                                                    <% if(isOwner) { %>
                                                        <button data-space-id="<%= space._id %>" onclick="deleteSpace(this.dataset.spaceId)" title="Delete" class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                            <i class="ri-delete-bin-line text-xl"></i> 
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <div
                                                class="glass-panel-light rounded-2xl h-[250px] overflow-y-auto custom-scrollbar p-4 space-y-3">
                                                <% if(!space.files || space.files.length===0) { %>
                                                    <div
                                                        class="flex flex-col items-center justify-center h-full text-white/40">
                                                        <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                                                        <p class="text-xl">No public files available yet.</p>
                                                    </div>
                                                    <% } else { %>
                                                        <% space.files.forEach(file=> { %>
                                                            <div
                                                                class="glass-card flex items-center justify-between p-4 rounded-xl group">
                                                                <div
                                                                    class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                                                                    <div
                                                                        class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-cyan-300">
                                                                        <i class="ri-file-line text-xl"></i>
                                                                    </div>
                                                                    <div class="truncate">
                                                                        <a href="/view-public/<%= file.s3Key %>"
                                                                            class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                                                            <%= file.originalName %>
                                                                        </a>
                                                                        <div class="flex items-center gap-2 mt-0.5">
                                                                            <span
                                                                                class="text-sm font-medium text-blue-200/70">
                                                                                @<%= file.owner && file.owner.username ?
                                                                                    file.owner.username : 'Unknown' %>
                                                                            </span>
                                                                            <% if (file.size) { %>
                                                                                <span class="text-xs text-blue-200/70">
                                                                                    • <%= (file.size / 1024 /
                                                                                        1024).toFixed(2) %> MB
                                                                                </span>
                                                                                <% } %>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="flex items-center gap-3">
                                                                    <% 
                                                                    const isFileOwner = user && file.owner && (file.owner._id || file.owner).toString() === user._id.toString();
                                                                    if (canDownload && !isFileOwner) { %>
                                                                        <a href="/download-public/<%= file.s3Key %>"
                                                                            download="<%= file.originalName %>"
                                                                            class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110">
                                                                            <i class="ri-download-line text-xl"></i>
                                                                        </a>
                                                                    <% } %>
                                                                            <% if (user && (file.owner &&
                                                                                (file.owner._id ||
                                                                                file.owner).toString()===user._id.toString()
                                                                                || isOwner)) { %>
                                                                                <button
                                                                                    onclick="deletePublicFile('<%= space._id %>', '<%= file._id %>', this)"
                                                                                    title="Delete"
                                                                                    class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                                                        class="ri-delete-bin-line text-xl"></i></button>
                                                                                <% } %>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                                <% } %>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <div class="text-center text-white/50 py-10">
                                                    <i class="ri-folder-add-line text-5xl mb-3 block opacity-50"></i>
                                                    <p>No user spaces created yet. Be the first!</p>
                                                </div>
                                                <% } %>
        </div>
    </main>
    <!-- Create Space Modal -->
