    <!-- Upload to Space Modal -->
    <div id="spaceUploadModal"
        class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-md px-4 text-center">
        <div class="glass-panel w-full max-w-lg rounded-2xl p-8 shadow-2xl relative">
            <button onclick="document.getElementById('spaceUploadModal').classList.add('hidden')"
                class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors">
                <i class="ri-close-line text-3xl"></i>
            </button>

            <div
                class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-white/20 shadow-inner">
                <i class="ri-upload-cloud-2-fill text-3xl text-cyan-300"></i>
            </div>

            <h2 id="spaceUploadTitle" class="text-2xl font-bold mb-2 text-white">Upload to Space</h2>
            <p id="spaceUploadDesc" class="text-blue-200 text-sm mb-8">Upload a file to this space.</p>

            <form id="spaceUploadForm" method="POST" enctype="multipart/form-data" class="space-y-5">
                <label
                    class="flex h-32 w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/30 bg-white/5 hover:bg-white/10 group transition-all">
