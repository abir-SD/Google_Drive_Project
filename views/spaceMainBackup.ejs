<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Drive - My Files</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
            position: relative;
        }

        @keyframes gradient {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* --- PREMIUM BUTTON ANIMATIONS --- */
        .btn-premium {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-icon-anim {
            position: absolute;
            left: -20px;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-text {
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Desktop Hover Logic */
        @media (hover: hover) {
            .btn-premium:hover .btn-icon-anim {
                left: 24px;
                opacity: 1;
            }

            .btn-premium:hover .btn-text {
                transform: translateX(12px);
            }
        }

        /* --- REST OF THE STYLES --- */
        #main-nav-container {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #mobile-menu {
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #mobile-menu.open {
            transform: translateX(0);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .glass-panel-light {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-0.5px);
            border-color: rgba(255, 255, 255, 0.3);
        }

        /* Highlight newly created space briefly */
        .created-highlight {
            animation: created-pulse 2s ease;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.12), 0 1px 0 rgba(99, 102, 241, 0.06) inset;
            border-color: rgba(59, 130, 246, 0.55) !important;
        }

        @keyframes created-pulse {
            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-2px) scale(1.01);
            }

            100% {
                transform: translateY(0);
            }
        }

        .nav-scrolled {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .nav-hide-bg {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom-color: transparent !important;
            box-shadow: none !important;
        }

        .nav-link {
            position: relative;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dbeafe;
            transition: color 0.3s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #67e8f9;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 50%;
            background-color: #67e8f9;
            transition: all 0.3s ease-in-out;
            transform: translateX(-50%);
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 100%;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }


        .space-blur {
            filter: blur(15px);
            pointer-events: none;
            user-select: none;
        }

        /* --- Toast Notifications --- */
        #toast-container {
            position: fixed;
            top: 20%;
            left: 20px;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            opacity: 0;
            transform: translateX(100%);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            min-width: 300px;
            max-width: 350px;
        }

        .toast.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .toast-icon {
            font-size: 22px;
            margin-right: 12px;
        }

        .toast-success {
            background: rgba(4, 120, 87, 0.6);
            /* Emerald-700 with opacity */
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-color: rgba(16, 185, 129, 0.5);
            /* Emerald-500 with opacity */
        }

        .toast-error {
            background: rgba(153, 27, 27, 0.6);
            /* Red-700 with opacity */
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-color: rgba(220, 38, 38, 0.5);
            /* Red-600 with opacity */
        }
    </style>
</head>

<body class="animated-bg text-white flex flex-col items-center">
    <div id="toast-container"></div>

    <nav class="fixed top-0 w-full z-50 px-4">
        <div id="main-nav-container"
            class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4 rounded-b-xl border-b border-transparent bg-transparent">
            <a href="/welcome" class="flex items-center gap-2 relative z-[60]">
                <i class="ph-fill ph-cloud-arrow-up text-cyan-300 text-2xl"></i>
                <span class="font-bold tracking-tight text-xl">Your Drive</span>
            </a>

            <div class="hidden md:flex items-center gap-6 md:gap-8">
                <a href="/home" class="nav-link">
                    <i class="ph ph-user text-cyan-300"></i>
                    <span>Personal</span>
                </a>
                <a href="/global" class="nav-link">
                    <i class="ph ph-globe text-cyan-300"></i>
                    <span>Global</span>
                </a>
                <a href="/space" class="nav-link">
                    <i class="ph ph-lock-key text-cyan-300"></i>
                    <span>Protected</span>
                </a>
                <a href="/about" class="nav-link">
                    <i class="ph ph-info text-cyan-300"></i>
                    <span>About</span>
                </a>
                <div class="w-px h-6 bg-white/10 mx-1"></div>
                <a href="/members" class="nav-link">
                    <i class="ph-bold ph-users-three text-cyan-300"></i>
                    <span>Community</span>
                </a>
            </div>

            <button id="menu-btn" class="md:hidden relative z-[60] p-2 text-cyan-300 focus:outline-none"
                aria-label="Open menu" aria-expanded="false">
                <i id="menu-icon" class="ph-bold ph-list text-3xl"></i>
            </button>
        </div>

        <div id="mobile-menu"
            class="fixed inset-y-0 right-0 w-[280px] glass-panel z-50 md:hidden flex flex-col p-8 pt-28 shadow-2xl space-y-8">
            <a href="/home" class="nav-link text-lg">
                <i class="ph ph-user text-cyan-300 text-xl"></i>
                <span>Personal</span>
            </a>
            <a href="/global" class="nav-link text-lg">
                <i class="ph ph-globe text-cyan-300 text-xl"></i>
                <span>Global</span>
            </a>
            <a href="/space" class="nav-link text-lg">
                <i class="ph ph-lock-key text-cyan-300 text-xl"></i>
                <span>Protected</span>
            </a>
            <a href="/about" class="nav-link text-lg">
                <i class="ph ph-info text-cyan-300 text-xl"></i>
                <span>About</span>
            </a>
            <div class="w-full h-px bg-white/10"></div>
            <a href="/members" class="nav-link text-lg">
                <i class="ph-bold ph-users-three text-cyan-300 text-xl"></i>
                <span>Community</span>
            </a>
        </div>
    </nav>

    <main class="flex-grow flex flex-col items-center px-4 pt-48 pb-10 relative z-10 w-full">

        <!-- Dynamic Space -->

        <div class="w-full max-w-4xl space-y-8">

            <div class="text-center mb-8">
                <h1 class="text-4xl md:text-5xl font-bold tracking-tight flex items-center justify-center gap-3">
                    <i class="ri-lock-2-line text-cyan-300"></i>
                    <span>Protected Space</span>
                </h1>
                <p class="text-blue-100 mt-2 text-lg font-light">Share your files with your loved
                    one's
                </p>
            </div>
            <form id="space-search-form" class="flex flex-col sm:flex-row justify-center items-center gap-3">
                <div class="relative w-full max-w-md">
                    <i
                        class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-white/50 text-xl pointer-events-none"></i>
                    <input id="space-search-input" name="space" type="search" placeholder="Search space by name"
                        class="w-full bg-white/5 border border-white/10 rounded-full pl-12 pr-4 py-3 text-white placeholder:text-white/40 focus:outline-none focus:border-white/40" />
                </div>
                <button type="button" id="space-search-reset"
                    class="btn-premium w-full sm:flex-1 rounded-full bg-white text-blue-900 px-4 py-2 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none">
                    <i class="ri-loop-left-fill text-xl btn-icon-anim"></i>
                    <span class="btn-text">Reset</span>
                </button>
                <button id="create-space-btn"
                    class="btn-premium w-full sm:flex-1 rounded-full border-2 border-white/40 text-white px-4 py-2 font-bold hover:border-white/70 hover:text-blue-900 hover:bg-white hover:border-white transition-all duration-400">
                    <i class="ri-folder-add-line text-xl btn-icon-anim"></i>
                    <span class="btn-text">Create Space</span>
                </button>
            </form>
            <div id="space-search-msg" class="text-center text-sm text-white/60 mt-3"></div>
            <div id="spaces-container" class="space-y-10">
                <% spaces.forEach(space=> { %>
                    <% let ownerId=space.owner ? (space.owner._id || space.owner).toString() : null; const isOwner=user
                        && ownerId && user._id.toString()===ownerId; const
                        isUnlocked=unlockedSpaces.includes(space._id.toString()) || isOwner; %>
                        <div class="glass-panel rounded-[2rem] p-8 relative overflow-hidden"
                            data-space-id="<%= space._id %>" data-space-name="<%= space.name %>"
                            data-owner-id="<%= ownerId %>">
                            <div
                                class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center gap-4 mb-8">
                                <div class="flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center border-white-500/30">
                                        <i class="ri-folder-lock-line text-2xl  text-white/60"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-2xl font-bold text-white">
                                            <%= space.name %>
                                        </h3>
                                        <p class="text-sm text-white/60">Created by <span class="font-medium">@<%=
                                                    (space.owner && space.owner.username) ? space.owner.username
                                                    : 'Unknown' %></span></p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <% if(isUnlocked) { %>
                                        <a href="/download-space-all/<%= space._id %>" title="Download All"
                                            class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                class="ri-download-line text-xl"></i></a>
                                        <% if(isOwner) { %>
                                            <button data-space-id="<%= space._id %>" data-space-name="<%= space.name %>"
                                                onclick="openSpaceUpload(this.dataset.spaceId, this.dataset.spaceName)"
                                                title="Upload"
                                                class="flex-shrink-0 bg-white/10 hover:bg-blue-500 hover:text-white text-blue-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                    class="ri-upload-cloud-2-line"></i></button>
                                            <button data-space-id="<%= space._id %>"
                                                onclick="deleteSpace(this.dataset.spaceId)" title="Delete"
                                                class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                    class="ri-delete-bin-line text-xl"></i></button>
                                            <% } %>
                                                <% } %>
                                </div>
                            </div>

                            <div
                                class="glass-panel-light rounded-2xl h-[250px] overflow-y-auto custom-scrollbar p-4 space-y-3 <%= !isUnlocked ? 'space-blur' : '' %>">
                                <% if(isUnlocked && space.files.length===0) { %>
                                    <div class="flex flex-col items-center justify-center h-full text-white/40">
                                        <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                                        <p class="text-xl">No public files available yet.</p>
                                    </div>
                                    <% } %>
                                        <% if(isUnlocked) { %>
                                            <% space.files.forEach(file=> {
                                                const fileOwnerId = file.owner ? (file.owner._id ||
                                                file.owner).toString() : '';
                                                const spaceOwnerId = space.owner ? (space.owner._id ||
                                                space.owner).toString() : '';
                                                const canDelete = user && (user._id.toString() ===
                                                fileOwnerId || user._id.toString() === spaceOwnerId);
                                                %>
                                                <!-- From this -->
                                                <div
                                                    class="glass-card flex items-center justify-between p-4 rounded-xl group">
                                                    <div class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                                                        <div
                                                            class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-cyan-300">
                                                            <i class="ri-file-line text-xl"></i>
                                                        </div>
                                                        <div class="truncate">
                                                            <a href="/view-space/<%= file._id %>"
                                                                class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                                                <%= file.originalName %>
                                                            </a>

                                                            <div class="flex items-center gap-2 mt-0.5">
                                                                <span class="text-sm font-medium text-blue-200/70">
                                                                    @<%= file.owner && file.owner.username ?
                                                                        file.owner.username : 'Unknown' %>
                                                                </span>
                                                                <% if (file.size) { %>
                                                                    <span class="text-xs text-blue-200/70">
                                                                        • <%= (file.size / 1024 / 1024).toFixed(2) %> MB
                                                                    </span>
                                                                    <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <!-- Action Buttons Container -->
                                                    <div class="flex items-center gap-3">
                                                        <% if (canDelete) { %>
                                                            <button onclick="deleteFile('<%= file._id %>', this)"
                                                                title="Delete"
                                                                class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                                    class="ri-delete-bin-line text-xl"></i></button>
                                                            <% } else { %>
                                                                <a href="/download-space/<%= file._id %>"
                                                                    download="<%= file.originalName %>" title="Download"
                                                                    class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                                                                        class="ri-download-line text-xl"></i></a>
                                                                <% } %>
                                                    </div>
                                                </div>


                                                <% }) %>
                                                    <% } %>
                            </div>

                            <% if(!isUnlocked) { %>
                                <div
                                    class="absolute inset-0 z-[30] flex flex-col items-center justify-center bg-black/50 p-4 text-center">
                                    <div class="glass-panel w-full max-w-sm rounded-[2rem] p-8">
                                        <div class="mb-6">
                                            <div
                                                class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-white/20">
                                                <i class="ri-lock-password-fill text-3xl text-cyan-300"></i>
                                            </div>
                                            <h3 class="text-2xl font-bold text-white">
                                                <%= space.name %>
                                            </h3>
                                            <p class="text-sm text-blue-200/80 mt-1">
                                                Protected by @<%= (space.owner && space.owner.username) ?
                                                    space.owner.username : 'Community Member' %>
                                            </p>
                                        </div>

                                        <form action="/unlock-space/<%= space._id %>" method="POST"
                                            class="w-full space-y-4">
                                            <input type="password" name="password" placeholder="Enter Access Password"
                                                required
                                                class="w-full bg-white/5 border border-white/10 rounded-2xl p-3 focus:outline-none focus:border-cyan-400 transition text-center" />
                                            <button type="submit"
                                                class="btn-premium w-full rounded-full bg-white text-blue-900 px-4 py-2.5 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none text-center">
                                                <i class="ri-key-2-line text-xl btn-icon-anim"></i>
                                                <span class="btn-text">Unlock Space</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                        <% }) %>
            </div>


            <!-- Space Upload Modal -->
            <div id="spaceUploadModal"
                class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-md px-4 text-center">
                <div class="glass-panel w-full max-w-lg rounded-2xl p-8 shadow-2xl relative">
                    <button onclick="document.getElementById('spaceUploadModal').classList.add('hidden')"
                        class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors">
                        <i class="ri-close-line text-3xl"></i>
                    </button>
                    <div class="text-center mb-6">
                        <h2 id="spaceUploadTitle" class="text-2xl font-bold text-white">Upload to Space</h2>
                        <p id="spaceUploadDesc" class="text-blue-200 text-sm">Share files privately to this space.</p>
                    </div>
                    <form id="spaceUploadForm" method="POST" enctype="multipart/form-data">
                        <label
                            class="flex h-48 w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/30 bg-white/5 hover:bg-white/10 group">
                            <div id="space-dropzone-content"
                                class="flex flex-col items-center justify-center pt-5 pb-6 text-white/70 group-hover:text-white transition-colors">
                                <i
                                    class="ri-upload-cloud-line text-4xl text-cyan-300 mb-2 group-hover:scale-110 transition-transform"></i>
                                <p class="mb-2 text-sm"><span class="font-semibold text-cyan-200">Click to select
                                        file</span>
                                </p>
                                <p class="text-xs text-white/50">Any file type (MAX. 10MB)</p>
                            </div>

                            <div id="space-filename-display" class="hidden text-center text-white font-medium p-4">
                                <i class="ri-file-check-line text-4xl text-green-400 mb-2 block"></i>
                                <span id="space-file-name-text"></span>
                            </div>

                            <input id="space-dropzone-file" type="file" name="file" class="hidden" required />
                        </label>
                        <button type="submit"
                            class="btn-premium mt-6 w-full rounded-full bg-white text-blue-900 py-3.5 font-bold hover:bg-transparent hover:border-white hover:text-white border-2 border-transparent transition-all duration-400">
                            <i class="ri-upload-2-line text-xl btn-icon-anim"></i>
                            <span class="btn-text">Upload Now</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <!-- Create Space Modal (Moved outside main to fix z-index overlapping) -->
    <div id="createSpaceModal"
        class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-md px-4 text-center">
        <div class="glass-panel w-full max-w-lg rounded-2xl p-8 shadow-2xl relative">
            <button onclick="document.getElementById('createSpaceModal').classList.add('hidden')"
                class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors">
                <i class="ri-close-line text-3xl"></i>
            </button>

            <div
                class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-white/20 shadow-inner">
                <i class="ri-folder-add-fill text-3xl text-cyan-300"></i>
            </div>

            <h2 class="text-2xl font-bold mb-2 text-white">Create a New Space</h2>
            <p class="text-blue-200 text-sm mb-8">Create a private space to share files securely.</p>

            <form id="create-space-form" class="space-y-5">
                <div class="relative">
                    <i
                        class="ri-folder-3-line absolute left-4 top-1/2 -translate-y-1/2 text-white/50 text-xl pointer-events-none"></i>
                    <input type="text" name="name" required placeholder="Space Name"
                        class="w-full bg-white/5 border border-white/10 rounded-xl pl-12 pr-4 py-3.5 text-white placeholder:text-white/40 focus:outline-none focus:border-cyan-400/50 focus:bg-white/10 transition-all" />
                </div>

                <div class="relative">
                    <i
                        class="ri-lock-password-line absolute left-4 top-1/2 -translate-y-1/2 text-white/50 text-xl pointer-events-none"></i>
                    <input type="password" name="password" required placeholder="Access Password"
                        class="w-full bg-white/5 border border-white/10 rounded-xl pl-12 pr-4 py-3.5 text-white placeholder:text-white/40 focus:outline-none focus:border-cyan-400/50 focus:bg-white/10 transition-all" />
                </div>

                <div class="flex flex-col sm:flex-row gap-3 pt-4">
                    <button type="button" onclick="document.getElementById('createSpaceModal').classList.add('hidden')"
                        class="btn-premium w-full flex-1 rounded-full border-2 border-white/40 text-white px-4 py-3 font-bold hover:border-white/70 hover:text-blue-900 hover:bg-white hover:border-white transition-all duration-400">
                        <i class="ri-close-line text-xl btn-icon-anim"></i>
                        <span class="btn-text">Cancel</span>
                    </button>
                    <button type="submit"
                        class="btn-premium w-full flex-1 rounded-full bg-white text-blue-900 px-4 py-3 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none">
                        <i class="ri-add-line text-xl btn-icon-anim"></i>
                        <span class="btn-text">Create Space</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function showToast(message, type = 'success', duration = 4000) {
            let toastContainer = document.getElementById('toast-container');
            if (!toastContainer) {
                console.error('Toast container not found!');
                return;
            }

            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            const iconClass = type === 'success' ? 'ri-checkbox-circle-line' : 'ri-error-warning-line';

            toast.innerHTML = `
                <i class="${iconClass} toast-icon"></i>
                <span>${message}</span>
            `;

            toastContainer.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('visible');
            }, 10);

            setTimeout(() => {
                toast.classList.remove('visible');
                toast.addEventListener('transitionend', () => toast.remove());
            }, duration);
        }

        function openSpaceUpload(spaceId, spaceName) {
            const modal = document.getElementById('spaceUploadModal');
            const form = document.getElementById('spaceUploadForm');
            const title = document.getElementById('spaceUploadTitle');
            const desc = document.getElementById('spaceUploadDesc');

            // Reset UI for file input
            const dropzoneContent = document.getElementById('space-dropzone-content');
            const filenameDisplay = document.getElementById('space-filename-display');
            const fileInput = document.getElementById('space-dropzone-file');
            if (fileInput) fileInput.value = '';
            if (dropzoneContent) dropzoneContent.classList.remove('hidden');
            if (filenameDisplay) filenameDisplay.classList.add('hidden');

            form.action = `/upload-space/${spaceId}`;
            if (title) title.textContent = `Share with ${spaceName}`;
            if (desc) desc.textContent = `This file will only be visible to ${spaceName}.`;
            modal.classList.remove('hidden');
        }

        async function deleteFile(fileId, element) {
            if (confirm('Are you sure you want to delete this file?')) {
                try {
                    const response = await fetch(`/delete/${fileId}`, {
                        method: 'DELETE'
                    });
                    const result = await response.json();
                    if (result.success) {
                        element.closest('.glass-card').remove();
                        showToast(result.message, 'success');
                    } else {
                        showToast(result.message || 'Failed to delete file.', 'error');
                    }
                } catch (error) {
                    console.error('Error deleting file:', error);
                    showToast('An error occurred while deleting the file.', 'error');
                }
            }
        }

        async function deleteSpace(spaceId) {
            if (confirm('Are you sure you want to delete this space and all its files?')) {
                try {
                    const response = await fetch(`/space/${spaceId}`, {
                        method: 'DELETE'
                    });
                    const result = await response.json();
                    if (result.success) {
                        document.querySelector(`[data-space-id="${spaceId}"]`).remove();
                        showToast(result.message, 'success');
                    } else {
                        showToast(result.message || 'Failed to delete space.', 'error');
                    }
                } catch (error) {
                    console.error('Error deleting space:', error);
                    showToast('An error occurred while deleting the space.', 'error');
                }
            }
        }

        function createFileElement(file, spaceId) {
            const spaceCard = document.querySelector(`[data-space-id="${spaceId}"]`);
            const spaceOwnerId = spaceCard.dataset.ownerId;
            const currentUserId = '<%= user._id %>';

            const canDelete = currentUserId === (file.owner._id || file.owner).toString() || currentUserId === spaceOwnerId;

            const deleteButton = `
                <button
                    onclick="deleteFile('${file._id}', this)"
                    title="Delete"
                    class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                        class="ri-delete-bin-line text-xl"></i></button>
            `;

            const downloadButton = `
                <a href="/download-space/${file._id}"
                    download="${file.originalName}"
                    title="Download"
                    class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i
                        class="ri-download-line text-xl"></i></a>
            `;

            return `
                <div class="glass-card flex items-center justify-between p-4 rounded-xl group">
                    <div class="flex-grow min-w-0 pr-4 flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-cyan-300">
                            <i class="ri-file-line text-xl"></i>
                        </div>
                        <div class="truncate">
                            <a href="/view-space/${file._id}"
                                class="text-base font-medium sm:text-lg hover:text-cyan-300 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-cyan-300">
                                ${file.originalName}
                            </a>

                            <div class="flex items-center gap-2 mt-0.5">
                                <span class="text-sm font-medium text-blue-200/70">
                                    @${(file.owner && file.owner.username) ? file.owner.username : 'Unknown'}
                                </span>
                                ${file.size ? `<span class="text-xs text-blue-200/70">
                                    • ${(file.size / 1024 / 1024).toFixed(2)} MB
                                </span>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        ${canDelete ? deleteButton : downloadButton}
                    </div>
                </div>
            `;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const navContainer = document.getElementById('main-nav-container');
            const popUp = document.getElementById('popup');
            const menuBtn = document.getElementById('menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');

            // --- Toast Notifications from URL (for redirects) ---
            const urlParams = new URLSearchParams(window.location.search);
            const successMsg = urlParams.get('success');
            const errorMsg = urlParams.get('error');

            if (successMsg) {
                showToast(successMsg, 'success');
                // Clean the URL
                window.history.replaceState({}, document.title, window.location.pathname + window.location.hash);
            }
            if (errorMsg) {
                showToast(errorMsg, 'error');
                // Clean the URL
                window.history.replaceState({}, document.title, window.location.pathname + window.location.hash);
            }

            const handleScroll = () => {
                if (mobileMenu && mobileMenu.classList.contains('open')) {
                    navContainer.classList.add('nav-hide-bg');
                } else if (window.scrollY > 10) {
                    navContainer.classList.add('nav-scrolled');
                    navContainer.classList.remove('nav-hide-bg');
                } else {
                    navContainer.classList.remove('nav-scrolled');
                    navContainer.classList.remove('nav-hide-bg');
                }
            };

            function updateMenuIcon(isOpen) {
                const ic = document.getElementById('menu-icon');
                if (!ic) return;
                ic.className = isOpen ? 'ph-bold ph-x text-3xl' : 'ph-bold ph-list text-3xl';
            }
            function openMenu() {
                mobileMenu.classList.add('open');
                setTimeout(() => { navContainer.classList.add('nav-hide-bg'); }, 0);
                updateMenuIcon(true);
                document.body.style.overflow = 'hidden';
            }
            function closeMenu() {
                mobileMenu.classList.remove('open');
                navContainer.classList.remove('nav-hide-bg');
                updateMenuIcon(false);
                document.body.style.overflow = '';
            }

            menuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (mobileMenu.classList.contains('open')) closeMenu(); else openMenu();
            });

            document.addEventListener('pointerdown', (e) => {
                if (!mobileMenu.classList.contains('open')) return;
                if (mobileMenu.contains(e.target) || menuBtn.contains(e.target)) return;
                closeMenu();
            });

            window.addEventListener('scroll', handleScroll);
            handleScroll();

            function setActiveNav() {
                const anchors = document.querySelectorAll('a.nav-link');
                const currentPath = window.location.pathname;
                anchors.forEach(a => {
                    try {
                        const aPath = new URL(a.href, location.origin).pathname;
                        if (aPath === currentPath) {
                            a.classList.add('active');
                            a.setAttribute('aria-current', 'page');
                        }
                    } catch (e) { }
                });
            }
            setActiveNav();

            window.showPopUp = () => {
                popUp.classList.remove('hidden');
                setTimeout(() => { popUp.classList.remove('opacity-0'); }, 10);
            };
            window.hidePopUp = () => {
                popUp.classList.add('opacity-0');
                try {
                    const df = document.getElementById('dropzone-file');
                    const dcontent = document.getElementById('dropzone-content');
                    const fdisplay = document.getElementById('filename-display');
                    const fname = document.getElementById('file-name-text');
                    if (df) df.value = '';
                    if (fdisplay) fdisplay.classList.add('hidden');
                    if (dcontent) dcontent.classList.remove('hidden');
                    if (fname) fname.textContent = '';
                } catch (err) { }
                setTimeout(() => { popUp.classList.add('hidden'); }, 300);
            };

            const openUploadBtn = document.getElementById('open-upload-btn');
            if (openUploadBtn) openUploadBtn.addEventListener('click', (e) => {
                e.preventDefault();
                window.showPopUp();
            });
            const dropzoneInput = document.getElementById('dropzone-file');
            const dropzoneContent = document.getElementById('dropzone-content');
            const filenameDisplay = document.getElementById('filename-display');
            const fileNameText = document.getElementById('file-name-text');

            if (dropzoneInput) {
                dropzoneInput.addEventListener('change', () => {
                    const file = dropzoneInput.files[0];
                    if (file) {
                        if (dropzoneContent) dropzoneContent.classList.add('hidden');
                        if (filenameDisplay) filenameDisplay.classList.remove('hidden');
                        if (fileNameText) fileNameText.textContent = file.name;
                    }
                });
            }

            const spaceDropzoneInput = document.getElementById('space-dropzone-file');
            const spaceDropzoneContent = document.getElementById('space-dropzone-content');
            const spaceFilenameDisplay = document.getElementById('space-filename-display');
            const spaceFileNameText = document.getElementById('space-file-name-text');

            if (spaceDropzoneInput) {
                spaceDropzoneInput.addEventListener('change', () => {
                    const file = spaceDropzoneInput.files[0];
                    if (file) {
                        if (spaceDropzoneContent) spaceDropzoneContent.classList.add('hidden');
                        if (spaceFilenameDisplay) spaceFilenameDisplay.classList.remove('hidden');
                        if (spaceFileNameText) spaceFileNameText.textContent = file.name;
                    }
                });
            }

        });

        document.addEventListener('DOMContentLoaded', () => {
            const createSpaceBtn = document.getElementById('create-space-btn');
            const createSpaceModal = document.getElementById('createSpaceModal');
            const createSpaceForm = document.getElementById('create-space-form');
            const spacesContainer = document.getElementById('spaces-container');
            const searchForm = document.getElementById('space-search-form');
            const searchInput = document.getElementById('space-search-input');
            const searchReset = document.getElementById('space-search-reset');
            const searchMsg = document.getElementById('space-search-msg');

            function showAllSpaces() {
                if (!spacesContainer) return;
                spacesContainer.querySelectorAll('[data-space-id]').forEach(c => c.style.display = '');
                if (searchMsg) searchMsg.textContent = '';
            }

            function performSearch() {
                if (!spacesContainer || !searchInput) return showAllSpaces();
                const q = searchInput.value.trim();
                if (!q) return showAllSpaces();
                const normalized = q.toLowerCase();
                let found = 0;
                spacesContainer.querySelectorAll('[data-space-name]').forEach(card => {
                    const name = (card.dataset.spaceName || '').toLowerCase();
                    if (name.includes(normalized)) {
                        card.style.display = '';
                        found++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                if (searchMsg) searchMsg.textContent = found === 0 ? 'No space found with that name.' : '';
            }

            if (searchForm) searchForm.addEventListener('submit', (e) => { e.preventDefault(); performSearch(); });
            if (searchReset) searchReset.addEventListener('click', () => { if (searchInput) searchInput.value = ''; showAllSpaces(); });
            if (createSpaceBtn) createSpaceBtn.addEventListener('click', () => { createSpaceModal.classList.remove('hidden'); });

            if (createSpaceForm) {
                createSpaceForm.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    if (createSpaceForm.dataset.submitting === 'true') return;
                    createSpaceForm.dataset.submitting = 'true';

                    const submitBtn = createSpaceForm.querySelector('button[type="submit"]');
                    const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin text-xl btn-icon-anim"></i><span class="btn-text">Creating...</span>';
                    }

                    const formData = new FormData(createSpaceForm);
                    const data = Object.fromEntries(formData.entries());

                    try {
                        const response = await fetch('/create-space', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();

                        if (result.success) {
                            const newSpaceElement = createSpaceElement(result.space);
                            // Append to the end so ordering matches server (oldest -> newest)
                            spacesContainer.insertAdjacentHTML('beforeend', newSpaceElement);

                            // If there's an active search, re-run it so the new item respects filters
                            if (searchInput && searchInput.value.trim() !== '') performSearch();

                            // Try to scroll into view and highlight the newly created space for the user
                            const createdEl = spacesContainer.querySelector(`[data-space-id="${result.space._id}"]`);
                            if (createdEl) {
                                // Only scroll if visible
                                if (createdEl.offsetParent !== null) {
                                    createdEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                }
                                createdEl.classList.add('created-highlight');
                                setTimeout(() => createdEl.classList.remove('created-highlight'), 3000);
                            }

                            createSpaceModal.classList.add('hidden');
                            createSpaceForm.reset();
                            showToast('Space created successfully!', 'success');
                        } else {
                            showToast(result.message || 'Failed to create space.', 'error');
                        }
                    } catch (error) {
                        console.error('Error creating space:', error);
                        showToast('An error occurred while creating the space.', 'error');
                    } finally {
                        createSpaceForm.dataset.submitting = 'false';
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnContent;
                        }
                    }
                });
            }

            const spaceUploadForm = document.getElementById('spaceUploadForm');
            if (spaceUploadForm) {
                spaceUploadForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const formData = new FormData(spaceUploadForm);
                    const action = spaceUploadForm.action;
                    const spaceId = action.split('/').pop();

                    try {
                        const response = await fetch(action, {
                            method: 'POST',
                            body: formData,
                        });
                        const result = await response.json();

                        if (result.success) {
                            const spaceCard = document.querySelector(`[data-space-id="${spaceId}"]`);
                            if (spaceCard) {
                                const filesContainer = spaceCard.querySelector('.glass-panel-light');
                                const noFilesMessage = filesContainer.querySelector('.text-center.py-20') || filesContainer.querySelector('.flex.flex-col.items-center');
                                if (noFilesMessage) noFilesMessage.remove();

                                const newFileElement = createFileElement(result.file, spaceId);
                                filesContainer.insertAdjacentHTML('afterbegin', newFileElement);
                            }

                            showToast(result.message, 'success');
                            document.getElementById('spaceUploadModal').classList.add('hidden');
                            spaceUploadForm.reset();
                        } else {
                            showToast(result.message || 'Upload failed.', 'error');
                        }
                    } catch (error) {
                        console.error('Upload error:', error);
                        showToast('An error occurred during upload.', 'error');
                    }
                });
            }

            function createSpaceElement(space) {
                const ownerId = space.owner ? (space.owner._id || space.owner).toString() : '';
                return `
                <div class="glass-panel rounded-[2rem] p-8 relative overflow-hidden" data-space-id="${space._id}" data-space-name="${space.name}" data-owner-id="${ownerId}">
                    <div class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center gap-4 mb-8">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center border-white-500/30">
                                <i class="ri-folder-lock-line text-2xl  text-white/60"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-white">${space.name}</h3>
                                <p class="text-sm text-white/60">Created by <span class="font-medium">@${space.ownerUsername || '<%= (user && user.username) ? user.username : "You" %>'}</span></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <a href="/download-space-all/${space._id}" title="Download All" class="flex-shrink-0 bg-white/10 hover:bg-cyan-500 hover:text-white text-cyan-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-download-line text-xl"></i></a>
                            <button data-space-id="${space._id}" data-space-name="${space.name}" onclick="openSpaceUpload(this.dataset.spaceId, this.dataset.spaceName)" title="Upload" class="flex-shrink-0 bg-white/10 hover:bg-blue-500 hover:text-white text-blue-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-upload-cloud-2-line"></i></button>
                            <button data-space-id="${space._id}" onclick="deleteSpace(this.dataset.spaceId)" title="Delete" class="flex-shrink-0 bg-white/10 hover:bg-red-500 hover:text-white text-red-200 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition duration-200 group-hover:scale-110"><i class="ri-delete-bin-line text-xl"></i></button>
                        </div>
                    </div>
                    <div class="glass-panel-light rounded-2xl h-[250px] overflow-y-auto custom-scrollbar p-4 space-y-3">
                        <div class="flex flex-col items-center justify-center h-full text-white/40">
                            <i class="ri-folder-open-line text-6xl mb-4 block"></i>
                            <p class="text-xl">No public files available yet.</p>
                        </div>
                    </div>
                </div>
                `;
            }
        });
    </script>
</body>

</html>