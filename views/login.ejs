<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Drive - Login</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    
    <!-- Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Modern Gradient Background matching Home Page */
        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* FIX 1: Custom Focus Border (Simple Border Only) */
        .glass-input:focus {
            outline: none; 
            border-color: #22d3ee; 
        }
        
        /* Autofill Fix */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 30px rgba(255, 255, 255, 0.05) inset !important; 
            box-shadow: 0 0 0 30px rgba(255, 255, 255, 0.05) inset !important;
            -webkit-text-fill-color: white !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        /* Error UI Animation */
        @keyframes slideIn {
            from { transform: translateY(-10px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .error-alert {
            animation: slideIn 0.4s ease forwards;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            backdrop-filter: blur(8px);
        }

        /* --- Premium Button Logic --- */
        .btn-premium {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium .btn-arrow {
            position: absolute;
            left: -20px;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium .btn-text {
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium:hover .btn-arrow {
            left: 24px;
            opacity: 1;
        }

        .btn-premium:hover .btn-text {
            transform: translateX(10px);
        }

        .btn-white-style {
            background-color: white;
            color: #1e3a8a;
            border: 2px solid white;
        }
        .btn-white-style:hover {
            background-color: transparent;
            color: white;
            border-color: white;
        }
    </style>
</head>

<body class="animated-bg flex items-center justify-center p-4">

    <!-- Glass Container -->
    <div class="glass-panel w-full max-w-md p-8 rounded-3xl shadow-2xl relative overflow-hidden">
        
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="flex justify-center mb-4">
                <i class="ri-cloud-line text-cyan-300 text-5xl"></i>
            </div>
            <h2 class="text-3xl font-extrabold text-white tracking-tight">Welcome Back</h2>
            <p class="text-blue-200 mt-2 text-sm">Enter your credentials to access your drive</p>
        </div>

        <!-- Animated Error Alert -->
        <% if (error) { %>
            <div id="error-message" class="error-alert flex items-center gap-3 p-4 mb-6 rounded-xl text-red-200 text-sm">
                <i class="ri-error-warning-line text-lg text-red-400"></i>
                <span class="flex-1 font-medium"><%= error %></span>
            </div>
        <% } %>

        <!-- Login Form -->
        <form action="/user/login" method="post" class="space-y-6">
            
            <!-- Email Field -->
            <div>
                <label for="email" class="block mb-2 text-sm font-medium text-blue-100 ml-1">Email address</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="ri-mail-line text-blue-300"></i>
                    </div>
                    <input type="email" id="email" name="email" required
                        class="glass-input bg-white/5 border border-white/20 text-white text-sm rounded-xl block w-full pl-11 p-3.5 placeholder-white/30 transition-all backdrop-blur-sm shadow-sm"
                        placeholder="username@company.com" />
                </div>
            </div>

            <!-- Password Field -->
            <div>
                <label for="password" class="block mb-2 text-sm font-medium text-blue-100 ml-1">Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="ri-lock-line text-blue-300"></i>
                    </div>
                    <input type="password" id="password" name="password" required
                        class="glass-input bg-white/5 border border-white/20 text-white text-sm rounded-xl block w-full pl-11 p-3.5 placeholder-white/30 transition-all backdrop-blur-sm shadow-sm"
                        placeholder="•••••••••" />
                </div>
            </div>

            <!-- Remember Me & Terms -->
            <div class="flex items-start">
                <div class="flex items-center h-5">
                    <input id="remember" type="checkbox" value="" required
                        class="w-4 h-4 rounded border-white/30 bg-white/10 text-cyan-500 focus:ring-cyan-500 focus:ring-offset-0 focus:ring-offset-transparent cursor-pointer" />
                </div>
                <label for="remember" class="ms-2 text-sm font-medium text-blue-200 cursor-pointer">
                    I agree with the <a href="#" class="text-cyan-300 hover:text-white hover:underline transition-colors">terms and conditions</a>.
                </label>
            </div>

            <!-- Premium Submit Button -->
            <button type="submit" class="btn-premium btn-white-style w-full mt-4 px-8 py-3.5 rounded-full font-bold shadow-xl cursor-pointer">
                <i class="ri-arrow-right-line btn-arrow"></i>
                <span class="btn-text">Submit</span>
            </button>
            
            <!-- Google Sign-in Button -->
            <div class="text-center mt-4">
                <a href="/auth/google" class="inline-flex items-center justify-center w-full px-4 py-3 rounded-full bg-white/95 text-slate-800 font-semibold shadow-sm hover:bg-white/100 transition-colors">
                    <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" class="mr-3">
                        <path fill="#EA4335" d="M9 3.48c1.69 0 3.03.73 3.94 1.34l2.94-2.98C14.54.55 12.01 0 9 0 5.48 0 2.44 1.74.98 4.37l3.11 2.41C5.06 5.06 7.78 3.48 9 3.48z"/>
                        <path fill="#34A853" d="M17.64 9.2c0-.64-.06-1.25-.18-1.84H9v3.48h4.84c-.21 1.12-.85 2.08-1.82 2.72l2.94 2.28C16.85 15.02 17.64 12.34 17.64 9.2z"/>
                        <path fill="#FBBC05" d="M3.09 10.78A5.41 5.41 0 0 1 2.7 9c0-.62.11-1.21.3-1.78L.98 4.37A9 9 0 0 0 0 9c0 1.47.33 2.86.92 4.08l2.17-2.3z"/>
                        <path fill="#4285F4" d="M9 18c2.43 0 4.47-.8 5.96-2.17l-2.94-2.28c-.82.55-1.87.88-3.02.88-1.23 0-3.95-1.58-4.94-2.48L.98 13.63C2.44 16.26 5.48 18 9 18z"/>
                    </svg>
                    <span>Log in with Google</span>
                </a>
            </div>

            <!-- Registration Link (Moved under Submit Button for design consistency) -->
            <div class="text-center pt-2">
                <p class="text-sm font-medium text-blue-200/80">
                    Don't have an account yet?
                    <a href="/user/register" class="text-cyan-300 hover:text-white transition-colors font-bold ml-1">
                        Register here.
                    </a>
                </p>
            </div>
            
        </form>
    </div>

    <!-- Error auto-hide script -->
    <script>
        const errorBox = document.getElementById('error-message');
        if (errorBox) {
            setTimeout(() => {
                errorBox.style.transition = "all 0.6s cubic-bezier(0.4, 0, 0.2, 1)";
                errorBox.style.opacity = "0";
                errorBox.style.transform = "translateY(-10px)";
                setTimeout(() => errorBox.remove(), 600);
            }, 6000);
        }
    </script>
</body>

</html>