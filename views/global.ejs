                <div class="flex flex-col sm:flex-row gap-3 pt-4">
                    <button type="button" onclick="document.getElementById('spaceUploadModal').classList.add('hidden')"
                        class="btn-premium w-full flex-1 rounded-full border-2 border-white/40 text-white px-4 py-3 font-bold hover:border-white/70 hover:text-blue-900 hover:bg-white hover:border-white transition-all duration-400">
                        <span class="btn-text">Cancel</span>
                    </button>
                    <button type="submit"
                        class="btn-premium w-full flex-1 rounded-full bg-white text-blue-900 px-4 py-3 font-bold shadow-lg border-2 border-transparent hover:bg-transparent hover:border-white/70 hover:text-white focus:outline-none">
