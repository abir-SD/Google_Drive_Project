<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Drive - Community Members</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        /* Shared Animated Background */
        .animated-bg {
            background: linear-gradient(-45deg, #3b0764, #4c1d95, #2563eb, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            width: 100%;
            position: relative;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.12);
            transform: translateY(-1px);
            border-color: rgba(34, 211, 238, 0.3);
        }

        /* Dynamic Navbar Transition */
        #main-nav-container {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-scrolled {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            border-radius: 0 0 0.75rem 0.75rem;
        }

        .nav-hide-bg {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom-color: transparent !important;
            box-shadow: none !important;
        }

        /* Nav Link Underline Logic */
        .nav-link {
            position: relative;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dbeafe;
            transition: color 0.3s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #67e8f9;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 50%;
            background-color: #67e8f9;
            transition: all 0.3s ease-in-out;
            transform: translateX(-50%);
        }

        .nav-link:hover::after, .nav-link.active::after {
            width: 100%;
        }

        /* Mobile Menu Drawer Logic */
        #mobile-menu {
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #mobile-menu.open {
            transform: translateX(0);
        }

        /* --- PREMIUM BUTTON LOGIC --- */
        .btn-premium {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium .btn-arrow {
            position: absolute;
            left: -20px;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium .btn-text {
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium:hover .btn-arrow {
            left: 24px;
            opacity: 1;
        }

        .btn-premium:hover .btn-text {
            transform: translateX(10px);
        }

        /* White style used in login/members footer */
        .btn-white-style {
            background-color: white;
            color: #1e3a8a;
            border: 2px solid white;
        }
        .btn-white-style:hover {
            background-color: transparent;
            color: white;
            border-color: white;
        }

        /* Navigation Auth Buttons */
        .btn-signin-style {
            border: 2px solid rgba(255, 255, 255, 0.4);
            color: white;
            background: transparent;
        }

        .btn-signin-style:hover {
            background-color: white;
            color: #1e3a8a;
            border-color: white;
        }

        .btn-getstarted-style {
            background-color: white;
            color: #1e3a8a;
            border: 2px solid white;
        }

        .btn-getstarted-style:hover {
            background-color: transparent;
            color: white;
            border-color: white;
        }
    </style>
</head>

<body class="animated-bg text-white">

    <nav class="fixed top-0 w-full z-50 px-4">
        <div id="main-nav-container"
            class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4 rounded-b-xl border-b border-transparent bg-transparent">
            <!-- Brand -->
            <a href="/welcome" class="flex items-center gap-2 relative z-[60]">
                <i class="ph-fill ph-cloud-arrow-up text-cyan-300 text-2xl"></i>
                <span class="font-bold tracking-tight text-xl">Your Drive</span>
            </a>

            <!-- Desktop Links -->
            <div class="hidden md:flex items-center gap-6 md:gap-8">
                <a href="/home" class="nav-link">
                    <i class="ph ph-user text-cyan-300"></i>
                    <span>Personal</span>
                </a>
                <a href="/global" class="nav-link">
                    <i class="ph ph-globe text-cyan-300"></i>
                    <span>Global</span>
                </a>
                <a href="/space" class="nav-link">
                    <i class="ph ph-lock-key text-cyan-300"></i>
                    <span>Protected</span>
                </a>
                <a href="/about" class="nav-link">
                    <i class="ph ph-info text-cyan-300"></i>
                    <span>About</span>
                </a>
                <div class="w-px h-6 bg-white/10 mx-1"></div>
                <a href="/members" class="nav-link">
                    <i class="ph-bold ph-users-three text-cyan-300"></i>
                    <span>Community</span>
                </a>
            </div>

            <button id="menu-btn" class="md:hidden relative z-[60] p-2 text-cyan-300 focus:outline-none" aria-label="Open menu" aria-expanded="false">
                <i id="menu-icon" class="ph-bold ph-list text-3xl"></i>
            </button>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="mobile-menu"
            class="fixed inset-y-0 right-0 w-[280px] glass-panel z-50 md:hidden flex flex-col p-8 pt-28 shadow-2xl space-y-8">
            <a href="/home" class="nav-link text-lg">
                <i class="ph ph-user text-cyan-300 text-xl"></i>
                <span>Personal</span>
            </a>
            <a href="/global" class="nav-link text-lg">
                <i class="ph ph-globe text-cyan-300 text-xl"></i>
                <span>Global</span>
            </a>
            <a href="/space" class="nav-link text-lg">
                <i class="ph ph-lock-key text-cyan-300 text-xl"></i>
                <span>Protected</span>
            </a>
            <a href="/about" class="nav-link text-lg">
                <i class="ph ph-info text-cyan-300 text-xl"></i>
                <span>About</span>
            </a>
            <div class="w-full h-px bg-white/10"></div>
            <a href="/members" class="nav-link text-lg">
                <i class="ph-bold ph-users-three text-cyan-300 text-xl"></i>
                <span>Community</span>
            </a>

            <div class="pt-10 flex flex-col gap-4">
                <a href="/user/login" class="btn-signin-style text-center w-full px-4 py-3 rounded-full font-semibold">Sign In</a>
                <a href="/user/register" class="btn-getstarted-style text-center w-full px-4 py-3 rounded-full font-bold">Get Started</a>
            </div>
        </div>
    </nav>

    <main class="pt-32 pb-20 px-4 max-w-6xl mx-auto relative z-10">
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">Our Trusted <span class="text-cyan-300">Community</span></h1>
            <p class="text-blue-100 max-w-2xl mx-auto text-lg font-light leading-relaxed">
                Join thousands of users who trust us with their digital assets. Transparency is the core of our security.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
            <div class="glass-panel p-8 rounded-3xl relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i class="ri-team-line text-9xl"></i>
                </div>
                <p class="text-cyan-300 text-5xl font-extrabold mb-1"><%= count %></p>
                <p class="uppercase tracking-widest text-blue-200 font-bold text-sm">Active Members</p>
                <div class="mt-4 h-1 w-12 bg-cyan-400 rounded-full"></div>
            </div>

            <div class="glass-panel p-8 rounded-3xl relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i class="ri-shield-check-line text-9xl"></i>
                </div>
                <p class="text-green-400 text-5xl font-extrabold mb-1"><%= totalFiles %></p>
                <p class="uppercase tracking-widest text-blue-200 font-bold text-sm">Files Protected</p>
                <div class="mt-4 h-1 w-12 bg-green-400 rounded-full"></div>
            </div>
        </div>

        <div class="glass-panel rounded-[2rem] shadow-2xl p-8 relative">
            <div class="flex items-center gap-3 mb-8">
                <i class="ri-group-line text-cyan-300 text-2xl"></i>
                <h3 class="text-2xl font-bold">Recent Members</h3>
            </div>

            <div id="members-container" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                <% if (users && users.length > 0) { %>
                    <% users.forEach(user => { %>
                        <div class="glass-card flex items-center gap-4 p-5 rounded-2xl group">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/20 flex items-center justify-center text-cyan-300 border border-white/10 group-hover:scale-105 transition-transform">
                                <i class="ri-user-smile-line text-3xl"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-bold text-white text-lg truncate"><%= user.username %></p>
                                <p class="text-sm text-blue-200/60 truncate flex items-center gap-1">
                                    <i class="ri-mail-check-line text-xs"></i>
                                    <%= user.email %>
                                </p>
                            </div>
                            <div class="hidden sm:block opacity-0 group-hover:opacity-100 transition-opacity">
                                <i class="ri-verified-badge-line text-cyan-400"></i>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-10 text-center text-blue-200/50">
                        No community members found.
                    </div>
                <% } %>
            </div>
        </div>

        <!-- UPDATED CTA: Premium Button Design matching Login Page -->
        <div class="mt-16 flex flex-col items-center gap-6">
            <p class="text-blue-100 font-medium">Ready to secure your own files?</p>
            <a href="/user/register" class="btn-premium btn-white-style w-full max-w-xs px-8 py-4 rounded-full font-bold shadow-xl cursor-pointer">
                <i class="ri-arrow-right-line btn-arrow"></i>
                <span class="btn-text">Join the Community</span>
            </a>
        </div>
    </main>

    <footer class="text-center py-6 text-white/40 text-sm relative z-10">
        &copy; 2025 Your Drive. All rights reserved.
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const navContainer = document.getElementById('main-nav-container');
            const menuBtn = document.getElementById('menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');

            function updateMenuIcon(isOpen) {
                const ic = document.getElementById('menu-icon');
                if (!ic) return;
                ic.className = isOpen ? 'ph-bold ph-x text-3xl' : 'ph-bold ph-list text-3xl';
            }
            function openMenu() {
                mobileMenu.classList.add('open');
                navContainer.classList.add('nav-hide-bg');
                updateMenuIcon(true);
                document.body.style.overflow = 'hidden';
            }
            function closeMenu() {
                mobileMenu.classList.remove('open');
                navContainer.classList.remove('nav-hide-bg');
                updateMenuIcon(false);
                document.body.style.overflow = '';
            }

            menuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (mobileMenu.classList.contains('open')) closeMenu(); else openMenu();
            });

            document.addEventListener('pointerdown', (e) => {
                if (!mobileMenu.classList.contains('open')) return;
                if (mobileMenu.contains(e.target) || menuBtn.contains(e.target)) return;
                closeMenu();
            });

            const handleScroll = () => {
                if (window.scrollY > 10) {
                    navContainer.classList.add('nav-scrolled');
                } else {
                    navContainer.classList.remove('nav-scrolled');
                }
            };

            window.addEventListener('scroll', handleScroll);
            handleScroll();
        });
    </script>
</body>

</html>